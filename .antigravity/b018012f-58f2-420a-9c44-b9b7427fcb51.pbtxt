      replacement_content: "# ============================================================================\n# PRIVACY GATEWAY \342\200\224 ENVIRONMENT CONFIGURATION (PHASE 2)\n# ============================================================================\n\n# Service Runtime\nNODE_ENV=development\nPORT=3000\nHOST=0.0.0.0\n\n# Database & Redis Configuration\nPOSTGRES_HOST=localhost\nPOSTGRES_PORT=5432\nPOSTGRES_DB=privacy_gateway\nPOSTGRES_USER=pgadmin\nPOSTGRES_PASSWORD=pgsecret_change_in_production\n\nREDIS_HOST=localhost\nREDIS_PORT=6379\nREDIS_PASSWORD=redissecret_change_in_production\n\n# Google OAuth 2.0 / OpenID Connect (Development Credentials)\n# Web Client:\nGOOGLE_CLIENT_ID=your_dev_web_client_id.apps.googleusercontent.com\nGOOGLE_CLIENT_SECRET=your_dev_web_client_secret\nGOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback\n\n# Native Desktop Client (For Phase 5 Preparation):\nGOOGLE_DESKTOP_CLIENT_ID=your_dev_desktop_client_id.apps.googleusercontent.com\n\n# Asymmetric RS256 JWT Configuration\n# In production, supply 2048-bit or 4096-bit RSA PEM strings.\n# In development, leave blank to use auto-generated ephemeral keypair.\nJWT_PRIVATE_KEY_PEM=\nJWT_PUBLIC_KEY_PEM=\nJWT_KEY_ID=pg-auth-2026-v1\nJWT_ISSUER=https://api.privacygateway.net\nJWT_AUDIENCE=https://privacygateway.net\n\n# CORS & Security Limits\nCORS_ORIGIN=http://localhost:3000\nRATE_LIMIT_MAX=100\nRATE_LIMIT_WINDOW_MS=60000\n"
