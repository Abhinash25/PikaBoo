        target_content: "      } catch (err) {\n        await client.query(\'ROLLBACK\');\n        throw err;\n      } finally {\n        client.release();\n      }\n    } catch (dbErr) {\n      // If PostgreSQL is unreachable in local dev sandbox, execute fallback in-memory store\n      return AuthService.processGoogleAuthInMemory(claims, userAgent);\n    }\n  }\n\n  /**\n   * Fallback in-memory identity resolution for isolated container environments\n   */\n  private static processGoogleAuthInMemory(\n    claims: GoogleIdTokenClaims,\n    userAgent?: string\n  ): AuthSuccessResult {\n    let existingAccount: InMemoryAuthAccount | undefined;\n    for (const acc of memoryDb.authAccounts.values()) {\n      if (acc.provider === \'google\' && acc.provider_subject_id === claims.sub) {\n        existingAccount = acc;\n        break;\n      }\n    }\n\n    let user: InMemoryUser;\n    if (existingAccount) {\n      const foundUser = memoryDb.users.get(existingAccount.user_id);\n      if (!foundUser) {\n        throw new Error(\'CORRUPTED_USER_IDENTITY\');\n      }\n      user = foundUser;\n      if (!user.is_active) {\n        throw new Error(\'USER_ACCOUNT_SUSPENDED\');\n      }\n    } else {\n      // Check duplicate email\n      for (const u of memoryDb.users.values()) {\n        if (u.email.toLowerCase() === claims.email.toLowerCase()) {\n          throw new Error(\'ACCOUNT_EXISTS_LINKING_REQUIRED\');\n        }\n      }\n\n      const userId = crypto.randomUUID();\n      user = {\n        id: userId,\n        email: claims.email,\n        display_name: claims.name || null,\n        avatar_url: claims.picture || null,\n        role: \'user\',\n        is_active: true,\n        data_retention_days: 30,\n        created_at: new Date(),\n      };\n      memoryDb.users.set(userId, user);\n\n      const accId = crypto.randomUUID();\n      memoryDb.authAccounts.set(accId, {\n        id: accId,\n        user_id: userId,\n        provider: \'google\',\n        provider_subject_id: claims.sub,\n        email_at_provider: claims.email,\n      });\n    }\n\n    const sessionId = crypto.randomUUID();\n    const familyId = crypto.randomUUID();\n    const { rawToken, tokenHash } = generateRefreshToken();\n    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);\n\n    memoryDb.sessions.set(sessionId, {\n      id: sessionId,\n      user_id: user.id,\n      family_id: familyId,\n      refresh_token_hash: tokenHash,\n      user_agent: userAgent || null,\n      created_at: new Date(),\n      last_used_at: new Date(),\n      expires_at: expiresAt,\n      revoked_at: null,\n    });\n\n    AuthService.recordDiagnostic({\n      step: \'DB_IDENTITY\',\n      status: \'PASS\',\n      details: \'Identity resolved and persisted (Container In-Memory)\',\n    });\n    AuthService.recordDiagnostic({\n      step: \'SESSION_CREATE\',\n      status: \'PASS\',\n      details: \'Session token family initialized (Container In-Memory)\',\n    });\n\n    const accessToken = generateAccessToken({\n      sub: user.id,\n      email: user.email,\n      role: user.role,\n      sessionId,\n      familyId,\n    });\n\n    const csrfToken = generateCsrfToken();\n\n    const userDto: UserProfileDto = {\n      id: user.id,\n      email: user.email,\n      displayName: user.display_name,\n      avatarUrl: user.avatar_url,\n      role: user.role,\n      isActive: user.is_active,\n      dataRetentionDays: user.data_retention_days,\n      createdAt: user.created_at.toISOString(),\n    };\n\n    return {\n      accessToken,\n      refreshToken: rawToken,\n      csrfToken,\n      user: userDto,\n      sessionId,\n    };\n  }\n\n  /**\n   * Atomically rotate refresh token within Token Family with Replay Protection\n   */\n  static async rotateSessionToken(\n    rawRefreshToken: string,\n    userAgent?: string\n  ): Promise<{ accessToken: string; newRefreshToken: string; csrfToken: string; user: UserProfileDto }> {\n    const tokenHash = hashToken(rawRefreshToken);\n\n    try {\n      const pool = getDatabasePool();\n      const client = await pool.connect();\n      try {\n        await client.query(\'BEGIN\');\n\n        const sessionRes = await client.query(\n          `SELECT s.*, u.email, u.display_name, u.avatar_url, u.role, u.is_active, u.data_retention_days, u.created_at as user_created_at\n           FROM user_sessions s\n           JOIN users u ON s.user_id = u.id\n           WHERE s.refresh_token_hash = $1\n           FOR UPDATE`,\n          [tokenHash]\n        );\n\n        if (sessionRes.rows.length === 0) {\n          const historyRes = await client.query(\n            `SELECT family_id, session_id FROM session_token_history WHERE token_hash = $1`,\n            [tokenHash]\n          );\n\n          if (historyRes.rows.length > 0) {\n            const replayFamilyId = historyRes.rows[0].family_id;\n            await client.query(\n              `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE family_id = $1`,\n              [replayFamilyId]\n            );\n            await client.query(\'COMMIT\');\n            throw new Error(\'TOKEN_FAMILY_REVOKED_REPLAY_DETECTED\');\n          }\n\n          throw new Error(\'INVALID_REFRESH_TOKEN\');\n        }\n\n        const session = sessionRes.rows[0];\n        if (session.revoked_at !== null) throw new Error(\'SESSION_REVOKED\');\n        if (new Date(session.expires_at) < new Date()) throw new Error(\'SESSION_EXPIRED\');\n        if (!session.is_active) throw new Error(\'USER_INACTIVE\');\n\n        const { rawToken: newRawToken, tokenHash: newHash } = generateRefreshToken();\n\n        await client.query(\n          `INSERT INTO session_token_history (session_id, family_id, token_hash)\n           VALUES ($1, $2, $3)`,\n          [session.id, session.family_id, tokenHash]\n        );\n\n        await client.query(\n          `UPDATE user_sessions\n         SET refresh_token_hash = $1, last_used_at = CURRENT_TIMESTAMP, user_agent = COALESCE($2, user_agent)\n         WHERE id = $3`,\n          [newHash, userAgent || null, session.id]\n        );\n\n        await client.query(\'COMMIT\');\n\n        const accessToken = generateAccessToken({\n          sub: session.user_id,\n          email: session.email,\n          role: session.role,\n          sessionId: session.id,\n          familyId: session.family_id,\n        });\n\n        const csrfToken = generateCsrfToken();\n\n        const userDto: UserProfileDto = {\n          id: session.user_id,\n          email: session.email,\n          displayName: session.display_name,\n          avatarUrl: session.avatar_url,\n          role: session.role,\n          isActive: session.is_active,\n          dataRetentionDays: session.data_retention_days,\n          createdAt: new Date(session.user_created_at).toISOString(),\n        };\n\n        return {\n          accessToken,\n          newRefreshToken: newRawToken,\n          csrfToken,\n          user: userDto,\n        };\n      } catch (err) {\n        await client.query(\'ROLLBACK\');\n        throw err;\n      } finally {\n        client.release();\n      }\n    } catch (dbErr) {\n      // Memory Store fallback for Token Family rotation\n      return AuthService.rotateSessionTokenInMemory(tokenHash, userAgent);\n    }\n  }\n\n  private static rotateSessionTokenInMemory(\n    tokenHash: string,\n    userAgent?: string\n  ): { accessToken: string; newRefreshToken: string; csrfToken: string; user: UserProfileDto } {\n    let session: InMemorySession | undefined;\n    for (const s of memoryDb.sessions.values()) {\n      if (s.refresh_token_hash === tokenHash) {\n        session = s;\n        break;\n      }\n    }\n\n    if (!session) {\n      // Replay attack check in token history\n      const historyItem = memoryDb.tokenHistory.find((th) => th.token_hash === tokenHash);\n      if (historyItem) {\n        // Revoke entire family\n        for (const s of memoryDb.sessions.values()) {\n          if (s.family_id === historyItem.family_id) {\n            s.revoked_at = new Date();\n          }\n        }\n        throw new Error(\'TOKEN_FAMILY_REVOKED_REPLAY_DETECTED\');\n      }\n      throw new Error(\'INVALID_REFRESH_TOKEN\');\n    }\n\n    if (session.revoked_at !== null) throw new Error(\'SESSION_REVOKED\');\n    if (session.expires_at < new Date()) throw new Error(\'SESSION_EXPIRED\');\n\n    const user = memoryDb.users.get(session.user_id);\n    if (!user || !user.is_active) throw new Error(\'USER_INACTIVE\');\n\n    const { rawToken: newRawToken, tokenHash: newHash } = generateRefreshToken();\n\n    // Push to history\n    memoryDb.tokenHistory.push({\n      id: crypto.randomUUID(),\n      session_id: session.id,\n      family_id: session.family_id,\n      token_hash: tokenHash,\n      created_at: new Date(),\n    });\n\n    session.refresh_token_hash = newHash;\n    session.last_used_at = new Date();\n    if (userAgent) session.user_agent = userAgent;\n\n    const accessToken = generateAccessToken({\n      sub: user.id,\n      email: user.email,\n      role: user.role,\n      sessionId: session.id,\n      familyId: session.family_id,\n    });\n\n    const csrfToken = generateCsrfToken();\n\n    const userDto: UserProfileDto = {\n      id: user.id,\n      email: user.email,\n      displayName: user.display_name,\n      avatarUrl: user.avatar_url,\n      role: user.role,\n      isActive: user.is_active,\n      dataRetentionDays: user.data_retention_days,\n      createdAt: user.created_at.toISOString(),\n    };\n\n    return {\n      accessToken,\n      newRefreshToken: newRawToken,\n      csrfToken,\n      user: userDto,\n    };\n  }\n\n  /**\n   * Revoke session by ID\n   */\n  static async revokeSession(sessionId: string, userId: string): Promise<boolean> {\n    try {\n      const pool = getDatabasePool();\n      const res = await pool.query(\n        `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE id = $1 AND user_id = $2`,\n        [sessionId, userId]\n      );\n      if ((res.rowCount ?? 0) > 0) return true;\n    } catch {\n      // Fallback\n    }\n\n    const session = memoryDb.sessions.get(sessionId);\n    if (session && session.user_id === userId) {\n      session.revoked_at = new Date();\n      return true;\n    }\n    return false;\n  }\n\n  /**\n   * Revoke current session by refresh token\n   */\n  static async revokeSessionByToken(rawRefreshToken: string): Promise<void> {\n    const tokenHash = hashToken(rawRefreshToken);\n    try {\n      const pool = getDatabasePool();\n      await pool.query(\n        `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE refresh_token_hash = $1`,\n        [tokenHash]\n      );\n    } catch {\n      // Fallback\n    }\n\n    for (const s of memoryDb.sessions.values()) {\n      if (s.refresh_token_hash === tokenHash) {\n        s.revoked_at = new Date();\n      }\n    }\n  }\n\n  /**\n   * List active sessions for a user\n   */\n  static async listUserSessions(userId: string, currentSessionId: string): Promise<SessionItemDto[]> {\n    try {\n      const pool = getDatabasePool();\n      const res = await pool.query(\n        `SELECT id, family_id, user_agent, created_at, last_used_at, expires_at\n         FROM user_sessions\n         WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > CURRENT_TIMESTAMP\n         ORDER BY last_used_at DESC`,\n        [userId]\n      );\n\n      return res.rows.map((row) => ({\n        id: row.id,\n        familyId: row.family_id,\n        userAgent: row.user_agent,\n        createdAt: new Date(row.created_at).toISOString(),\n        lastUsedAt: new Date(row.last_used_at).toISOString(),\n        expiresAt: new Date(row.expires_at).toISOString(),\n        isCurrent: row.id === currentSessionId,\n      }));\n    } catch {\n      // Fallback to in-memory\n      const results: SessionItemDto[] = [];\n      const now = new Date();\n      for (const s of memoryDb.sessions.values()) {\n        if (s.user_id === userId && s.revoked_at === null && s.expires_at > now) {\n          results.push({\n            id: s.id,\n            familyId: s.family_id,\n            userAgent: s.user_agent,\n            createdAt: s.created_at.toISOString(),\n            lastUsedAt: s.last_used_at.toISOString(),\n            expiresAt: s.expires_at.toISOString(),\n            isCurrent: s.id === currentSessionId,\n          });\n        }\n      }\n      return results;\n    }\n  }\n\n  /**\n   * Get user profile by ID\n   */\n  static async getUserProfile(userId: string): Promise<UserProfileDto | null> {\n    try {\n      const pool = getDatabasePool();\n      const res = await pool.query(\n        `SELECT id, email, display_name, avatar_url, role, is_active, data_retention_days, created_at\n         FROM users WHERE id = $1`,\n        [userId]\n      );\n\n      if (res.rows.length > 0) {\n        const u = res.rows[0];\n        return {\n          id: u.id,\n          email: u.email,\n          displayName: u.display_name,\n          avatarUrl: u.avatar_url,\n          role: u.role,\n          isActive: u.is_active,\n          dataRetentionDays: u.data_retention_days,\n          createdAt: new Date(u.created_at).toISOString(),\n        };\n      }\n    } catch {\n      // Fallback\n    }\n\n    const u = memoryDb.users.get(userId);\n    if (!u) return null;\n    return {\n      id: u.id,\n      email: u.email,\n      displayName: u.display_name,\n      avatarUrl: u.avatar_url,\n      role: u.role,\n      isActive: u.is_active,\n      dataRetentionDays: u.data_retention_days,\n      createdAt: u.created_at.toISOString(),\n    };\n  }\n}"
        replacement_content: "      } catch (err) {\n        await client.query(\'ROLLBACK\');\n        throw err;\n      } finally {\n        client.release();\n      }\n    } catch (dbErr) {\n      AuthService.recordDiagnostic({\n        step: \'DB_IDENTITY\',\n        status: \'FAIL\',\n        category: \'DATABASE_UNAVAILABLE\',\n        details: (dbErr as Error).message || \'PostgreSQL database unreachable\',\n      });\n      throw new Error(`DATABASE_UNAVAILABLE: PostgreSQL is unreachable or failed transaction: ${(dbErr as Error).message}`);\n    }\n  }\n\n  /**\n   * Atomically rotate refresh token within Token Family with Replay Protection (PostgreSQL authoritative)\n   */\n  static async rotateSessionToken(\n    rawRefreshToken: string,\n    userAgent?: string\n  ): Promise<{ accessToken: string; newRefreshToken: string; csrfToken: string; user: UserProfileDto }> {\n    const tokenHash = hashToken(rawRefreshToken);\n\n    const pool = getDatabasePool();\n    const client = await pool.connect();\n    try {\n      await client.query(\'BEGIN\');\n\n      const sessionRes = await client.query(\n        `SELECT s.*, u.email, u.display_name, u.avatar_url, u.role, u.is_active, u.data_retention_days, u.created_at as user_created_at\n         FROM user_sessions s\n         JOIN users u ON s.user_id = u.id\n         WHERE s.refresh_token_hash = $1\n         FOR UPDATE`,\n        [tokenHash]\n      );\n\n      if (sessionRes.rows.length === 0) {\n        const historyRes = await client.query(\n          `SELECT family_id, session_id FROM session_token_history WHERE token_hash = $1`,\n          [tokenHash]\n        );\n\n        if (historyRes.rows.length > 0) {\n          const replayFamilyId = historyRes.rows[0].family_id;\n          await client.query(\n            `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE family_id = $1`,\n            [replayFamilyId]\n          );\n          await client.query(\'COMMIT\');\n          throw new Error(\'TOKEN_FAMILY_REVOKED_REPLAY_DETECTED\');\n        }\n\n        throw new Error(\'INVALID_REFRESH_TOKEN\');\n      }\n\n      const session = sessionRes.rows[0];\n      if (session.revoked_at !== null) throw new Error(\'SESSION_REVOKED\');\n      if (new Date(session.expires_at) < new Date()) throw new Error(\'SESSION_EXPIRED\');\n      if (!session.is_active) throw new Error(\'USER_INACTIVE\');\n\n      const { rawToken: newRawToken, tokenHash: newHash } = generateRefreshToken();\n\n      await client.query(\n        `INSERT INTO session_token_history (session_id, family_id, token_hash)\n         VALUES ($1, $2, $3)`,\n        [session.id, session.family_id, tokenHash]\n      );\n\n      await client.query(\n        `UPDATE user_sessions\n         SET refresh_token_hash = $1, last_used_at = CURRENT_TIMESTAMP, user_agent = COALESCE($2, user_agent)\n         WHERE id = $3`,\n        [newHash, userAgent || null, session.id]\n      );\n\n      await client.query(\'COMMIT\');\n\n      const accessToken = generateAccessToken({\n        sub: session.user_id,\n        email: session.email,\n        role: session.role,\n        sessionId: session.id,\n        familyId: session.family_id,\n      });\n\n      const csrfToken = generateCsrfToken();\n\n      const userDto: UserProfileDto = {\n        id: session.user_id,\n        email: session.email,\n        displayName: session.display_name,\n        avatarUrl: session.avatar_url,\n        role: session.role,\n        isActive: session.is_active,\n        dataRetentionDays: session.data_retention_days,\n        createdAt: new Date(session.user_created_at).toISOString(),\n      };\n\n      return {\n        accessToken,\n        newRefreshToken: newRawToken,\n        csrfToken,\n        user: userDto,\n      };\n    } catch (err) {\n      await client.query(\'ROLLBACK\');\n      throw err;\n    } finally {\n      client.release();\n    }\n  }\n\n  /**\n   * Revoke session by ID in PostgreSQL\n   */\n  static async revokeSession(sessionId: string, userId: string): Promise<boolean> {\n    const pool = getDatabasePool();\n    const res = await pool.query(\n      `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE id = $1 AND user_id = $2`,\n      [sessionId, userId]\n    );\n    return (res.rowCount ?? 0) > 0;\n  }\n\n  /**\n   * Revoke current session by refresh token in PostgreSQL\n   */\n  static async revokeSessionByToken(rawRefreshToken: string): Promise<void> {\n    const tokenHash = hashToken(rawRefreshToken);\n    const pool = getDatabasePool();\n    await pool.query(\n      `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE refresh_token_hash = $1`,\n      [tokenHash]\n    );\n  }\n\n  /**\n   * List active sessions for a user from PostgreSQL\n   */\n  static async listUserSessions(userId: string, currentSessionId: string): Promise<SessionItemDto[]> {\n    const pool = getDatabasePool();\n    const res = await pool.query(\n      `SELECT id, family_id, user_agent, created_at, last_used_at, expires_at\n       FROM user_sessions\n       WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > CURRENT_TIMESTAMP\n       ORDER BY last_used_at DESC`,\n      [userId]\n    );\n\n    return res.rows.map((row) => ({\n      id: row.id,\n      familyId: row.family_id,\n      userAgent: row.user_agent,\n      createdAt: new Date(row.created_at).toISOString(),\n      lastUsedAt: new Date(row.last_used_at).toISOString(),\n      expiresAt: new Date(row.expires_at).toISOString(),\n      isCurrent: row.id === currentSessionId,\n    }));\n  }\n\n  /**\n   * Get user profile by ID from PostgreSQL\n   */\n  static async getUserProfile(userId: string): Promise<UserProfileDto | null> {\n    const pool = getDatabasePool();\n    const res = await pool.query(\n      `SELECT id, email, display_name, avatar_url, role, is_active, data_retention_days, created_at\n       FROM users WHERE id = $1`,\n      [userId]\n    );\n\n    if (res.rows.length > 0) {\n      const u = res.rows[0];\n      retu