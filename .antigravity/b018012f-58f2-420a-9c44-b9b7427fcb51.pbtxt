  file_change {
    absolute_path_uri: "file:///apps/api/src/services/auth.service.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// In-memory fallback stores for single-instance or local development when external services are offline\nconst inMemoryOAuthStates = new Map<string, { data: OAuthTransactionData; expiresAt: number }>();\nconst diagnosticEvents: OAuthDiagnosticEvent[] = [];\n\n// Fallback in-memory relational tables for local sandbox resilience\ninterface InMemoryUser {\n  id: string;\n  email: string;\n  display_name: string | null;\n  avatar_url: string | null;\n  role: UserRole;\n  is_active: boolean;\n  data_retention_days: number;\n  created_at: Date;\n}\n\ninterface InMemoryAuthAccount {\n  id: string;\n  user_id: string;\n  provider: string;\n  provider_subject_id: string;\n  email_at_provider: string;\n}\n\ninterface InMemorySession {\n  id: string;\n  user_id: string;\n  family_id: string;\n  refresh_token_hash: string;\n  user_agent: string | null;\n  created_at: Date;\n  last_used_at: Date;\n  expires_at: Date;\n  revoked_at: Date | null;\n}\n\ninterface InMemoryTokenHistory {\n  id: string;\n  session_id: string;\n  family_id: string;\n  token_hash: string;\n  created_at: Date;\n}\n\nconst memoryDb = {\n  users: new Map<string, InMemoryUser>(),\n  authAccounts: new Map<string, InMemoryAuthAccount>(),\n  sessions: new Map<string, InMemorySession>(),\n  tokenHistory: [] as InMemoryTokenHistory[],\n};\n\nexport class AuthService {\n  /**\n   * Safe diagnostic recording (Never logs secrets, tokens, codes, or keys)\n   */\n  static recordDiagnostic(event: Omit<OAuthDiagnosticEvent, \'timestamp\'>) {\n    const fullEvent: OAuthDiagnosticEvent = {\n      ...event,\n      timestamp: new Date().toISOString(),\n    };\n    diagnosticEvents.push(fullEvent);\n    if (diagnosticEvents.length > 50) {\n      diagnosticEvents.shift();\n    }\n  }\n\n  /**\n   * Retrieve safe diagnostics history\n   */\n  static getDiagnostics(): OAuthDiagnosticEvent[] {\n    return [...diagnosticEvents];\n  }\n\n  /**\n   * Store OAuth state in Redis (5 min TTL) with in-memory fallback\n   */\n  static async saveOAuthState(state: string, data: OAuthTransactionData): Promise<void> {\n    // 1. In-memory TTL backup\n    inMemoryOAuthStates.set(state, {\n      data,\n      expiresAt: Date.now() + 300 * 1000,\n    });\n\n    // 2. Redis if connected\n    try {\n      const redis = getRedisClient();\n      if (redis && redis.status === \'ready\') {\n        await redis.set(`pg:oauth:state:${state}`, JSON.stringify(data), \'EX\', 300);\n      }\n    } catch {\n      // Redis unavailable; in-memory fallback active\n    }\n\n    AuthService.recordDiagnostic({\n      step: \'REDIS_STATE\',\n      status: \'PASS\',\n      details: \'OAuth state persisted with 300s TTL\',\n    });\n  }\n\n  /**\n   * Consume OAuth state atomically via GETDEL\n   */\n  static async consumeOAuthState(state: string): Promise<OAuthTransactionData | null> {\n    let result: OAuthTransactionData | null = null;\n\n    // 1. Try Redis GETDEL\n    try {\n      const redis = getRedisClient();\n      if (redis && redis.status === \'ready\') {\n        const raw = await redis.getdel(`pg:oauth:state:${state}`);\n        if (raw) {\n          result = JSON.parse(raw) as OAuthTransactionData;\n        }\n      }\n    } catch {\n      // Redis fallback to in-memory\n    }\n\n    // 2. If not retrieved from Redis, check in-memory map\n    if (!result) {\n      const entry = inMemoryOAuthStates.get(state);\n      if (entry) {\n        inMemoryOAuthStates.delete(state); // Atomic consumption\n        if (entry.expiresAt > Date.now()) {\n          result = entry.data;\n        }\n      }\n    }\n\n    if (!result) {\n      AuthService.recordDiagnostic({\n        step: \'REDIS_STATE\',\n        status: \'FAIL\',\n        category: \'OAUTH_STATE_INVALID_OR_EXPIRED\',\n        details: \'State parameter not found or expired\',\n      });\n    }\n\n    return result;\n  }"
      replacement_content: "// In-memory short-lived store for transient PKCE OAuth state handshakes (300s TTL)\nconst inMemoryOAuthStates = new Map<string, { data: OAuthTransactionData; expiresAt: number }>();\nconst diagnosticEvents: OAuthDiagnosticEvent[] = [];\n\nexport class AuthService {\n  /**\n   * Safe diagnostic recording (Never logs secrets, tokens, codes, or keys)\n   */\n  static recordDiagnostic(event: Omit<OAuthDiagnosticEvent, \'timestamp\'>) {\n    const fullEvent: OAuthDiagnosticEvent = {\n      ...event,\n      timestamp: new Date().toISOString(),\n    };\n    diagnosticEvents.push(fullEvent);\n    if (diagnosticEvents.length > 50) {\n      diagnosticEvents.shift();\n    }\n  }\n\n  /**\n   * Retrieve safe diagnostics history\n   */\n  static getDiagnostics(): OAuthDiagnosticEvent[] {\n    return [...diagnosticEvents];\n  }\n\n  /**\n   * Store OAuth state in Redis (5 min TTL) with in-memory transient fallback\n   */\n  static async saveOAuthState(state: string, data: OAuthTransactionData): Promise<void> {\n    // 1. In-memory transient fallback for short-lived state\n    inMemoryOAuthStates.set(state, {\n      data,\n      expiresAt: Date.now() + 300 * 1000,\n    });\n\n    // 2. Redis if connected\n    try {\n      const redis = getRedisClient();\n      if (redis && redis.status === \'ready\') {\n        await redis.set(`pg:oauth:state:${state}`, JSON.stringify(data), \'EX\', 300);\n      }\n    } catch {\n      // Redis offline in local sandbox\n    }\n\n    AuthService.recordDiagnostic({\n      step: \'REDIS_STATE\',\n      status: \'PASS\',\n      details: \'OAuth state persisted with 300s TTL\',\n    });\n  }\n\n  /**\n   * Consume OAuth state atomically via GETDEL\n   */\n  static async consumeOAuthState(state: string): Promise<OAuthTransactionData | null> {\n    let result: OAuthTransactionData | null = null;\n\n    // 1. Try Redis GETDEL\n    try {\n      const redis = getRedisClient();\n      if (redis && redis.status === \'ready\') {\n        const raw = await redis.getdel(`pg:oauth:state:${state}`);\n        if (raw) {\n          result = JSON.parse(raw) as OAuthTransactionData;\n        }\n      }\n    } catch {\n      // Redis offline fallback to local transient map\n    }\n\n    // 2. If not retrieved from Redis, check in-memory map\n    if (!result) {\n      const entry = inMemoryOAuthStates.get(state);\n      if (entry) {\n        inMemoryOAuthStates.delete(state); // Atomic consumption\n        if (entry.expiresAt > Date.now()) {\n          result = entry.data;\n        }\n      }\n    }\n\n    if (!result) {\n      AuthService.recordDiagnostic({\n        step: \'REDIS_STATE\',\n        status: \'FAIL\',\n        category: \'OAUTH_STATE_INVALID_OR_EXPIRED\',\n        details: \'State parameter not found or expired\',\n      });\n    }\n\n    return result;\n  }"
    }
