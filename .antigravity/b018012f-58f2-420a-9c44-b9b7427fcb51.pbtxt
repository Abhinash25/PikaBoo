  file_change {
    absolute_path_uri: "file:///docker-compose.yml"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "# ============================================================================\n# PRIVACY GATEWAY \342\200\224 DOCKER COMPOSE DEVELOPMENT & SERVICE ORCHESTRATION\n# Phase 1 Foundation: Secure Defaults, Least Privilege, Isolated Networks\n# ============================================================================\n\nversion: \'3.9\'\n\nservices:\n  # 1. PostgreSQL Relational Database (With UUID & Crypto Extensions)\n  postgres:\n    image: postgres:16.2-alpine\n    container_name: pg_database\n    restart: unless-stopped\n    user: \"postgres\"\n    read_only: true\n    tmpfs:\n      - /tmp\n      - /var/run/postgresql\n    security_opt:\n      - no-new-privileges:true\n    cap_drop:\n      - ALL\n    environment:\n      POSTGRES_DB: ${POSTGRES_DB:-privacy_gateway}\n      POSTGRES_USER: ${POSTGRES_USER:-pgadmin}\n      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-pgsecret_change_in_production}\n    volumes:\n      - pgdata:/var/lib/postgresql/data:rw\n      - ./infrastructure/migrations:/docker-entrypoint-initdb.d:ro\n    ports:\n      - \"127.0.0.1:5432:5432\"\n    networks:\n      - pg-internal-net\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U ${POSTGRES_USER:-pgadmin} -d ${POSTGRES_DB:-privacy_gateway}\"]\n      interval: 10s\n      timeout: 5s\n      retries: 5\n    deploy:\n      resources:\n        limits:\n          cpus: \'1.0\'\n          memory: 512M\n\n  # 2. Redis In-Memory Real-time Event Bus & Cache\n  redis:\n    image: redis:7.2-alpine\n    container_name: pg_redis\n    restart: unless-stopped\n    user: \"999:999\"\n    read_only: true\n    security_opt:\n      - no-new-privileges:true\n    cap_drop:\n      - ALL\n    command: [\"redis-server\", \"--appendonly\", \"yes\", \"--requirepass\", \"${REDIS_PASSWORD:-redissecret_change_in_production}\"]\n    volumes:\n      - redisdata:/data:rw\n    ports:\n      - \"127.0.0.1:6379:6379\"\n    networks:\n      - pg-internal-net\n    healthcheck:\n      test: [\"CMD\", \"redis-cli\", \"-a\", \"${REDIS_PASSWORD:-redissecret_change_in_production}\", \"ping\"]\n      interval: 10s\n      timeout: 5s\n      retries: 5\n    deploy:\n      resources:\n        limits:\n          cpus: \'0.5\'\n          memory: 256M\n\n  # 3. Privacy Gateway Core API Service\n  api:\n    build:\n      context: .\n      dockerfile: docker/api/Dockerfile\n    container_name: pg_api\n    restart: unless-stopped\n    user: \"10001:10001\"\n    read_only: true\n    tmpfs:\n      - /tmp\n    security_opt:\n      - no-new-privileges:true\n    cap_drop:\n      - ALL\n    depends_on:\n      postgres:\n        condition: service_healthy\n      redis:\n        condition: service_healthy\n    environment:\n      NODE_ENV: production\n      PORT: 3000\n      HOST: 0.0.0.0\n      POSTGRES_HOST: postgres\n      POSTGRES_PORT: 5432\n      POSTGRES_DB: ${POSTGRES_DB:-privacy_gateway}\n      POSTGRES_USER: ${POSTGRES_USER:-pgadmin}\n      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-pgsecret_change_in_production}\n      REDIS_HOST: redis\n      REDIS_PORT: 6379\n      REDIS_PASSWORD: ${REDIS_PASSWORD:-redissecret_change_in_production}\n    ports:\n      - \"3000:3000\"\n    networks:\n      - pg-internal-net\n      - pg-public-net\n    healthcheck:\n      test: [\"CMD-SHELL\", \"wget -qO- http://127.0.0.1:3000/health/live || exit 1\"]\n      interval: 10s\n      timeout: 3s\n      retries: 3\n    deploy:\n      resources:\n        limits:\n          cpus: \'1.0\'\n          memory: 512M\n\nvolumes:\n  pgdata:\n    driver: local\n  redisdata:\n    driver: local\n\nnetworks:\n  pg-internal-net:\n    internal: true\n    driver: bridge\n  pg-public-net:\n    driver: bridge\n"
    }
