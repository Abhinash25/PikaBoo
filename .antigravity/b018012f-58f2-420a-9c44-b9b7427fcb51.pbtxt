  file_change {
    absolute_path_uri: "file:///apps/api/src/controllers/auth.controller.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Request, Response } from \'express\';\nimport crypto from \'node:crypto\';\nimport { getEnv } from \'../config/env\';\nimport { AuthService } from \'../services/auth.service\';\n\n/**\n * Helper to compute S256 code challenge\n */\nfunction generateCodeChallenge(verifier: string): string {\n  return crypto.createHash(\'sha256\').update(verifier).digest(\'base64url\');\n}\n\n/**\n * Configure standard HTTP authentication cookies\n */\nfunction setAuthCookies(\n  res: Response,\n  accessToken: string,\n  refreshToken: string,\n  csrfToken: string,\n  isProduction: boolean\n) {\n  const secure = isProduction;\n\n  // 15-minute access token\n  res.cookie(\'pg_access_token\', accessToken, {\n    httpOnly: true,\n    secure,\n    sameSite: \'lax\',\n    path: \'/\',\n    maxAge: 15 * 60 * 1000,\n  });\n\n  // 30-day refresh token restricted to /api/v1/auth path\n  res.cookie(\'pg_refresh_token\', refreshToken, {\n    httpOnly: true,\n    secure,\n    sameSite: \'strict\',\n    path: \'/api/v1/auth\',\n    maxAge: 30 * 24 * 60 * 60 * 1000,\n  });\n\n  // CSRF Double-Submit token (accessible to client JS)\n  res.cookie(\'pg_csrf_token\', csrfToken, {\n    httpOnly: false,\n    secure,\n    sameSite: \'lax\',\n    path: \'/\',\n    maxAge: 30 * 24 * 60 * 60 * 1000,\n  });\n}\n\n/**\n * Clear authentication cookies on logout\n */\nfunction clearAuthCookies(res: Response, isProduction: boolean) {\n  const secure = isProduction;\n  res.clearCookie(\'pg_access_token\', { httpOnly: true, secure, sameSite: \'lax\', path: \'/\' });\n  res.clearCookie(\'pg_refresh_token\', { httpOnly: true, secure, sameSite: \'strict\', path: \'/api/v1/auth\' });\n  res.clearCookie(\'pg_csrf_token\', { httpOnly: false, secure, sameSite: \'lax\', path: \'/\' });\n}\n\nexport class AuthController {\n  /**\n   * GET /api/v1/auth/google/start\n   * Initiates Google OIDC flow, stores transaction in Redis, and redirects to Google\n   */\n  static async startGoogleAuth(req: Request, res: Response) {\n    const env = getEnv();\n    const state = crypto.randomBytes(32).toString(\'hex\');\n    const nonce = crypto.randomBytes(32).toString(\'hex\');\n    const codeVerifier = crypto.randomBytes(32).toString(\'base64url\');\n    const codeChallenge = generateCodeChallenge(codeVerifier);\n\n    const returnTo = typeof req.query.return_to === \'string\' && req.query.return_to.startsWith(\'/\')\n      ? req.query.return_to\n      : \'/\';\n\n    // Store in Redis (5 min TTL)\n    await AuthService.saveOAuthState(state, {\n      nonce,\n      codeVerifier,\n      returnTo,\n      createdAt: Date.now(),\n    });\n\n    const googleAuthUrl = new URL(\'https://accounts.google.com/o/oauth2/v2/auth\');\n    googleAuthUrl.searchParams.set(\'client_id\', env.GOOGLE_CLIENT_ID);\n    googleAuthUrl.searchParams.set(\'response_type\', \'code\');\n    googleAuthUrl.searchParams.set(\'scope\', \'openid email profile\');\n    googleAuthUrl.searchParams.set(\'redirect_uri\', env.GOOGLE_REDIRECT_URI);\n    googleAuthUrl.searchParams.set(\'state\', state);\n    googleAuthUrl.searchParams.set(\'nonce\', nonce);\n    googleAuthUrl.searchParams.set(\'code_challenge\', codeChallenge);\n    googleAuthUrl.searchParams.set(\'code_challenge_method\', \'S256\');\n    googleAuthUrl.searchParams.set(\'prompt\', \'select_account\');\n\n    return res.redirect(googleAuthUrl.toString());\n  }\n\n  /**\n   * GET /api/v1/auth/google/callback\n   * Atomic state consumption via GETDEL, Google token exchange, user resolution, and session creation\n   */\n  static async handleGoogleCallback(req: Request, res: Response) {\n    const env = getEnv();\n    const { code, state, error } = req.query;\n\n    if (error) {\n      return res.redirect(`/?auth_error=${encodeURIComponent(String(error))}`);\n    }\n\n    if (typeof code !== \'string\' || typeof state !== \'string\') {\n      return res.status(400).json({\n        success: false,\n        error: { code: \'INVALID_OAUTH_CALLBACK\', message: \'Missing code or state in callback\' },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-cb\',\n      });\n    }\n\n    // Atomic consumption from Redis (GETDEL)\n    const transaction = await AuthService.consumeOAuthState(state);\n    if (!transaction) {\n      return res.status(400).json({\n        success: false,\n        error: {\n          code: \'OAUTH_STATE_INVALID_OR_EXPIRED\',\n          message: \'OAuth state was not found or already consumed. Please restart login.\',\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-cb\',\n      });\n    }\n\n    try {\n      // Direct server-to-server TLS exchange with Google\n      const { idToken } = await AuthService.exchangeGoogleCode(\n        code,\n        transaction.codeVerifier,\n        env.GOOGLE_REDIRECT_URI\n      );\n\n      // Verify claims and issue session\n      const userAgent = req.headers[\'user-agent\'] || \'Unknown Browser\';\n      const authResult = await AuthService.processGoogleAuth(\n        idToken,\n        env.GOOGLE_CLIENT_ID,\n        transaction.nonce,\n        userAgent\n      );\n\n      setAuthCookies(\n        res,\n        authResult.accessToken,\n        authResult.refreshToken,\n        authResult.csrfToken,\n        env.NODE_ENV === \'production\'\n      );\n\n      return res.redirect(transaction.returnTo || \'/\');\n    } catch (err) {\n      const errMsg = (err as Error).message;\n      return res.redirect(`/?auth_error=${encodeURIComponent(errMsg)}`);\n    }\n  }\n\n  /**\n   * POST /api/v1/auth/desktop/google/exchange\n   * RFC 8252 Native Desktop client PKCE exchange endpoint (Phase 5 preparation)\n   */\n  static async desktopGoogleExchange(req: Request, res: Response) {\n    const env = getEnv();\n    const { code, code_verifier, redirect_uri } = req.body;\n\n    if (!code || !code_verifier || !redirect_uri) {\n      return res.status(400).json({\n        success: false,\n        error: {\n          code: \'MISSING_PARAMETERS\',\n          message: \'code, code_verifier, and redirect_uri are required for desktop exchange\',\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-dt\',\n      });\n    }\n\n    // Strict validation of loopback redirect URI format\n    if (!redirect_uri.startsWith(\'http://127.0.0.1:\') && !redirect_uri.startsWith(\'http://[::1]:\')) {\n      return res.status(400).json({\n        success: false,\n        error: {\n          code: \'INVALID_REDIRECT_URI\',\n          message: \'Desktop redirect_uri must strictly target loopback 127.0.0.1 or [::1]\',\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-dt\',\n      });\n    }\n\n    try {\n      const { idToken } = await AuthService.exchangeGoogleCode(\n        code,\n        code_verifier,\n        redirect_uri,\n        env.GOOGLE_DESKTOP_CLIENT_ID\n      );\n\n      const userAgent = req.headers[\'user-agent\'] || \'Tauri Desktop Client\';\n      const authResult = await AuthService.processGoogleAuth(\n        idToken,\n        env.GOOGLE_DESKTOP_CLIENT_ID,\n        undefined,\n        userAgent\n      );\n\n      // Return tokens directly in JSON for desktop client OS keyring storage\n      return res.json({\n        success: true,\n        data: {\n          accessToken: authResult.accessToken,\n          refreshToken: authResult.refreshToken,\n          user: authResult.user,\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-dt\',\n      });\n    } catch (err) {\n      return res.status(400).json({\n        success: false,\n        error: {\n          code: \'DESKTOP_AUTH_FAILED\',\n          message: (err as Error).message,\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-dt\',\n      });\n    }\n  }\n\n  /**\n   * POST /api/v1/auth/refresh\n   * CSRF-protected atomic token family rotation & replay mitigation\n   */\n  static async refreshSession(req: Request, res: Response) {\n    const env = getEnv();\n    let refreshToken = req.cookies?.pg_refresh_token;\n\n    if (!refreshToken && req.body?.refreshToken) {\n      refreshToken = req.body.refreshToken;\n    }\n\n    if (!refreshToken) {\n      return res.status(401).json({\n        success: false,\n        error: { code: \'REFRESH_TOKEN_REQUIRED\', message: \'No refresh token provided\' },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-ref\',\n      });\n    }\n\n    try {\n      const userAgent = req.headers[\'user-agent\'];\n      const result = await AuthService.rotateSessionToken(refreshToken, userAgent);\n\n      setAuthCookies(\n        res,\n        result.accessToken,\n        result.newRefreshToken,\n        result.csrfToken,\n        env.NODE_ENV === \'production\'\n      );\n\n      return res.json({\n        success: true,\n        data: {\n          user: result.user,\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-ref\',\n      });\n    } catch (err) {\n      const msg = (err as Error).message;\n      clearAuthCookies(res, env.NODE_ENV === \'production\');\n\n      return res.status(401).json({\n        success: false,\n        error: {\n          code: msg === \'TOKEN_FAMILY_REVOKED_REPLAY_DETECTED\' ? \'TOKEN_FAMILY_REVOKED\' : \'INVALID_SESSION\',\n          message: msg,\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-ref\',\n      });\n    }\n  }\n\n  /**\n   * POST /api/v1/auth/logout\n   * CSRF-protected session revocation and cookie destruction\n   */\n  static async logout(req: Request, res: Response) {\n    const env = getEnv();\n    const refreshToken = req.cookies?.pg_refresh_token;\n\n    if (refreshToken) {\n      try {\n        await AuthService.revokeSessionByToken(refreshToken);\n      } catch {\n        // Continue to clear cookies even if DB is unavailable\n      }\n    }\n\n    clearAuthCookies(res, env.NODE_ENV === \'production\');\n\n    return res.json({\n      success: true,\n      data: { message: \'Logged out successfully\' },\n      timestamp: new Date().toISOString(),\n      requestId: (req as any).id || \'req-out\',\n    });\n  }\n\n  /**\n   * GET /api/v1/auth/me\n   * Fast stateless RS256 profile assertion\n   */\n  static async getMe(req: Request, res: Response) {\n    if (!req.user) {\n      return res.status(401).json({\n        success: false,\n        error: { code: \'UNAUTHORIZED\', message: \'Not authenticated\' },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-me\',\n      });\n    }\n\n    try {\n      const profile = await AuthService.getUserProfile(req.user.sub);\n      if (!profile) {\n        return res.status(404).json({\n          success: false,\n          error: { code: \'USER_NOT_FOUND\', message: \'User record not found\' },\n          timestamp: new Date().toISOString(),\n          requestId: (req as any).id || \'req-me\',\n        });\n      }\n\n      return res.json({\n        success: true,\n        data: {\n          user: profile,\n          sessionId: req.user.sessionId,\n          familyId: req.user.familyId,\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-me\',\n      });\n    } catch (err) {\n      return res.status(500).json({\n        success: false,\n        error: { code: \'INTERNAL_ERROR\', message: (err as Error).message },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-me\',\n      });\n    }\n  }\n\n  /**\n   * GET /api/v1/auth/sessions\n   * List active sessions belonging to the authenticated user\n   */\n  static async listSessions(req: Request, res: Response) {\n    if (!req.user) {\n      return res.status(401).json({\n        success: false,\n        error: { code: \'UNAUTHORIZED\', message: \'Not authenticated\' },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-sess\',\n      });\n    }\n\n    try {\n      const sessions = await AuthService.listUserSessions(req.user.sub, req.user.sessionId);\n      return res.json({\n        success: true,\n        data: sessions,\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-sess\',\n      });\n    } catch (err) {\n      return res.status(500).json({\n        success: false,\n        error: { code: \'INTERNAL_ERROR\', message: (err as Error).message },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-sess\',\n      });\n    }\n  }\n\n  /**\n   * DELETE /api/v1/auth/sessions/:id\n   * Revoke a specific session belonging to current user\n   */\n  static async revokeSession(req: Request, res: Response) {\n    if (!req.user) {\n      return res.status(401).json({\n        success: false,\n        error: { code: \'UNAUTHORIZED\', message: \'Not authenticated\' },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-rev\',\n      });\n    }\n\n    const { id } = req.params;\n    try {\n      const revoked = await AuthService.revokeSession(id, req.user.sub);\n      return res.json({\n        success: true,\n        data: { revoked, sessionId: id },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-rev\',\n      });\n    } catch (err) {\n      return res.status(500).json({\n        success: false,\n        error: { code: \'INTERNAL_ERROR\', message: (err as Error).message },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-rev\',\n      });\n    }\n  }\n}\n"
    }
