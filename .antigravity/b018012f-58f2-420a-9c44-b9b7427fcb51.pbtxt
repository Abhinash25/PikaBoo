        }
        lines {
          text: "| `/health/ready` | `GET` | Readiness probe confirming PostgreSQL connectivity before accepting traffic. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `/api/v1/system/info` | `GET` | System architecture parameters, security boundaries, and migration status. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `/api/v1/system/migrations` | `GET` | List of defined and applied database migrations. |"
