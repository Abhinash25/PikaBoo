    replacement_chunks {
      target_content: "  // Listen for popup cross-window postMessage events\n  useEffect(() => {\n    const handleOAuthMessage = (event: MessageEvent) => {\n      if (event.data?.type === \'OAUTH_AUTH_SUCCESS\') {\n        fetchCurrentUser();\n        fetchDiagnostics();\n        setAuthMessage({\n          type: \'success\',\n          text: \'Google Sign-In completed successfully! Authenticated session established.\',\n        });\n      } else if (event.data?.type === \'OAUTH_AUTH_ERROR\') {\n        fetchDiagnostics();\n        setAuthMessage({\n          type: \'error\',\n          text: `Google Sign-In failed or cancelled: ${event.data.error || \'Unknown error\'}`,\n        });\n      }\n    };\n    window.addEventListener(\'message\', handleOAuthMessage);\n    return () => window.removeEventListener(\'message\', handleOAuthMessage);\n  }, []);\n\n  const handleStartGoogleLogin = async () => {\n    setAuthLoading(true);\n    setAuthMessage(null);\n\n    try {\n      // 1. Fetch authorization URL from server\n      const res = await fetch(\'/api/v1/auth/google/start?mode=json\');\n      if (!res.ok) {\n        throw new Error(`Failed to initiate OAuth flow: HTTP ${res.status}`);\n      }\n      const data = await res.json();\n\n      if (data.isPlaceholderClientId) {\n        setAuthMessage({\n          type: \'info\',\n          text: \'Notice: Application is currently using a placeholder Google Client ID. You can configure real credentials via Settings / .env or test with authorized test credentials.\',\n        });\n      }\n\n      // 2. Open Google OAuth provider URL directly in popup\n      const authWindow = window.open(\n        data.url,\n        \'oauth_popup\',\n        \'width=550,height=650,left=200,top=100,menubar=no,toolbar=no\'\n      );\n\n      if (!authWindow) {\n        // If popup blocked, fallback to top-level navigation\n        window.location.href = data.url;\n      }\n    } catch (err) {\n      setAuthMessage({\n        type: \'error\',\n        text: `Error initiating Google Sign-In: ${(err as Error).message}`,\n      });\n    } finally {\n      setAuthLoading(false);\n      fetchDiagnostics();\n    }\n  };"
      replacement_content: "  // Listen for popup cross-window postMessage events with strict origin & source checks\n  useEffect(() => {\n    const handleOAuthMessage = (event: MessageEvent) => {\n      // 1. Strict Origin Validation\n      if (event.origin !== window.location.origin) {\n        return;\n      }\n\n      // 2. Source Window Validation\n      if (authPopupRef.current && event.source !== authPopupRef.current) {\n        return;\n      }\n\n      // 3. Process Status Event (No secrets/tokens accepted over postMessage)\n      if (event.data?.type === \'OAUTH_AUTH_SUCCESS\') {\n        authPopupRef.current = null;\n        fetchCurrentUser();\n        fetchDiagnostics();\n        setAuthMessage({\n          type: \'success\',\n          text: \'Google Sign-In completed successfully! Authenticated session established.\',\n        });\n      } else if (event.data?.type === \'OAUTH_AUTH_ERROR\') {\n        authPopupRef.current = null;\n        fetchDiagnostics();\n        setAuthMessage({\n          type: \'error\',\n          text: `Google Sign-In failed: ${event.data.error || \'Authentication error\'}`,\n        });\n      }\n    };\n    window.addEventListener(\'message\', handleOAuthMessage);\n    return () => window.removeEventListener(\'message\', handleOAuthMessage);\n  }, []);\n\n  const handleStartGoogleLogin = async () => {\n    setAuthLoading(true);\n    setAuthMessage(null);\n\n    try {\n      // 1. Fetch authorization URL from server\n      const res = await fetch(\'/api/v1/auth/google/start?mode=json\');\n      if (!res.ok) {\n        throw new Error(`Failed to initiate OAuth flow: HTTP ${res.status}`);\n      }\n      const data = await res.json();\n\n      if (data.isPlaceholderClientId) {\n        setAuthMessage({\n          type: \'info\',\n          text: \'Notice: Application is currently using a placeholder Google Client ID. Real Google OAuth requires registering your Google Client ID and Secret in .env and adding the Authorized Redirect URI in Google Cloud Console.\',\n        });\n      }\n\n      // 2. Open Google OAuth provider URL directly in popup\n      const authWindow = window.open(\n        data.url,\n        \'oauth_popup\',\n        \'width=550,height=650,left=200,top=100,menubar=no,toolbar=no\'\n      );\n\n      if (authWindow) {\n        authPopupRef.current = authWindow;\n      } else {\n        // If popup blocked, fallback to top-level navigation\n        window.location.href = data.url;\n      }\n    } catch (err) {\n      setAuthMessage({\n        type: \'error\',\n        text: `Error initiating Google Sign-In: ${(err as Error).message}`,\n      });\n    } finally {\n      setAuthLoading(false);\n      fetchDiagnostics();\n    }\n  };"
    }
