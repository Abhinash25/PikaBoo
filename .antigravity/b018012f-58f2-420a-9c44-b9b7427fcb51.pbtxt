  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Shield,\n  Server,\n  Database,\n  Layers,\n  Activity,\n  CheckCircle2,\n  AlertTriangle,\n  RefreshCw,\n  Cpu,\n  Lock,\n  Terminal,\n  FileCode,\n  Radio,\n  Clock,\n  ArrowUpRight,\n  Zap,\n} from \'lucide-react\';\nimport { HealthCheckResponse, SystemInfoResponse } from \'../packages/shared-types/src/api\';\n\nexport default function App() {\n  const [healthData, setHealthData] = useState<HealthCheckResponse | null>(null);\n  const [systemInfo, setSystemInfo] = useState<SystemInfoResponse | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const [lastRefreshed, setLastRefreshed] = useState<Date>(new Date());\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'schema\' | \'security\' | \'prober\'>(\'overview\');\n  const [probeResult, setProbeResult] = useState<{ endpoint: string; status: number; latencyMs: number; data: unknown } | null>(null);\n  const [probing, setProbing] = useState(false);\n\n  const fetchHealthAndSystem = async () => {\n    setIsLoading(true);\n    try {\n      const [healthRes, systemRes] = await Promise.all([\n        fetch(\'/health\'),\n        fetch(\'/api/v1/system/info\'),\n      ]);\n\n      if (healthRes.ok) {\n        const hData = await healthRes.json();\n        setHealthData(hData);\n      }\n      if (systemRes.ok) {\n        const sData = await systemRes.json();\n        setSystemInfo(sData.data);\n      }\n      setLastRefreshed(new Date());\n    } catch (err) {\n      console.error(\'Error fetching health/system status:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchHealthAndSystem();\n    const interval = setInterval(fetchHealthAndSystem, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  const runProbe = async (endpoint: string) => {\n    setProbing(true);\n    const start = performance.now();\n    try {\n      const res = await fetch(endpoint);\n      const latency = Math.round(performance.now() - start);\n      const data = await res.json();\n      setProbeResult({\n        endpoint,\n        status: res.status,\n        latencyMs: latency,\n        data,\n      });\n    } catch (err) {\n      const latency = Math.round(performance.now() - start);\n      setProbeResult({\n        endpoint,\n        status: 500,\n        latencyMs: latency,\n        data: { error: (err as Error).message },\n      });\n    } finally {\n      setProbing(false);\n    }\n  };\n\n  const schemaTables = [\n    { name: \'users\', role: \'Core identity records, data retention limits, and active status flags\', keys: \'PK: id (UUID), UK: email\' },\n    { name: \'authentication_accounts\', role: \'OIDC / Google OAuth linked accounts and provider subjects\', keys: \'PK: id, FK: user_id, UK: (provider, provider_subject_id)\' },\n    { name: \'user_sessions\', role: \'CSPRNG refresh token hashes and anonymized client metadata\', keys: \'PK: id, FK: user_id, UK: refresh_token_hash\' },\n    { name: \'devices\', role: \'Hardware devices, OS platforms, and client application versions\', keys: \'PK: id, FK: user_id\' },\n    { name: \'vpn_servers\', role: \'WireGuard infrastructure nodes, CIDR pools, and health state\', keys: \'PK: id, UK: public_endpoint\' },\n    { name: \'wireguard_peers\', role: \'Curve25519 public keys and allocated IPv4/IPv6 addresses\', keys: \'PK: id, FK: user_id, FK: vpn_server_id, UK: public_key\' },\n    { name: \'subscriptions\', role: \'Plan tiers (Free/Premium/Business), limits, and billing status\', keys: \'PK: id, FK: user_id\' },\n    { name: \'privacy_scans\', role: \'Deterministic 4-pillar privacy scores & diagnostic snapshots\', keys: \'PK: id, FK: user_id\' },\n    { name: \'privacy_events\', role: \'Configurable retention stream for tracker & diagnostic alerts\', keys: \'PK: id, FK: user_id\' },\n    { name: \'audit_logs\', role: \'Immutable security event log with actor and target records\', keys: \'PK: id, FK: actor_user_id\' },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cyan-500/20 selection:text-cyan-300\">\n      {/* Top Header */}\n      <header className=\"border-b border-slate-800 bg-slate-900/60 backdrop-blur-md sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/20\">\n              <Shield className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-lg font-semibold tracking-tight text-white\">Privacy Gateway</h1>\n                <span className=\"px-2 py-0.5 text-xs font-medium rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800/60\">\n                  Phase 1 Foundation\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">Production-Oriented VPN & Privacy Architecture</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-4\">\n            <div className=\"hidden sm:flex items-center gap-2 text-xs text-slate-400 bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5\">\n              <Clock className=\"w-3.5 h-3.5 text-slate-500\" />\n              <span>Polled: {lastRefreshed.toLocaleTimeString()}</span>\n            </div>\n\n            <button\n              id=\"refresh-btn\"\n              onClick={fetchHealthAndSystem}\n              disabled={isLoading}\n              className=\"flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium text-slate-200 bg-slate-800 hover:bg-slate-700 active:bg-slate-900 rounded-lg border border-slate-700 transition disabled:opacity-50\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? \'animate-spin text-cyan-400\' : \'\'}`} />\n              <span>Refresh Telemetry</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n        {/* Foundation Notice Banner */}\n        <section className=\"bg-gradient-to-r from-slate-900 via-slate-900 to-slate-850 border border-slate-800 rounded-xl p-5 shadow-sm\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n            <div className=\"space-y-1\">\n              <div className=\"flex items-center gap-2\">\n                <Zap className=\"w-4 h-4 text-cyan-400\" />\n                <h2 className=\"text-sm font-semibold text-slate-200 uppercase tracking-wider\">Phase 1 Infrastructure Operational</h2>\n              </div>\n              <p className=\"text-sm text-slate-400\">\n                Monorepo workspace initialized with decoupled Express backend, PostgreSQL migration engine, Redis event bus configuration, and secure non-root container defaults.\n              </p>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <div className=\"flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-950/80 border border-emerald-800 text-emerald-300 text-xs font-medium\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n                <span>Express API: Active (Port 3000)</span>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Live Service Metrics Grid */}\n        <section className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n          {/* Card 1: API Server Runtime */}\n          <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"p-2.5 rounded-lg bg-cyan-950/60 border border-cyan-800/50 text-cyan-400\">\n                  <Server className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-semibold text-slate-200\">Core API Service</h3>\n                  <p className=\"text-xs text-slate-400\">Express / TypeScript Engine</p>\n                </div>\n              </div>\n              <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-950 text-emerald-400 border border-emerald-800\">\n                Healthy\n              </span>\n            </div>\n\n            <div className=\"space-y-2 pt-2 border-t border-slate-800/80 text-xs\">\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Uptime</span>\n                <span className=\"text-slate-200 font-mono\">{healthData?.uptimeSeconds ?? 0}s</span>\n              </div>\n              <div className=\"flex justify-between text-slate-400\">\n                <span>RSS Memory</span>\n                <span className=\"text-slate-200 font-mono\">{healthData?.memoryUsageMb.rss ?? 0} MB</span>\n              </div>\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Heap Allocated</span>\n                <span className=\"text-slate-200 font-mono\">{healthData?.memoryUsageMb.heapUsed ?? 0} / {healthData?.memoryUsageMb.heapTotal ?? 0} MB</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Card 2: PostgreSQL Database */}\n          <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"p-2.5 rounded-lg bg-blue-950/60 border border-blue-800/50 text-blue-400\">\n                  <Database className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-semibold text-slate-200\">PostgreSQL 16</h3>\n                  <p className=\"text-xs text-slate-400\">Relational Database & Migrations</p>\n                </div>\n              </div>\n              <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-950 text-blue-400 border border-blue-800\">\n                Configured\n              </span>\n            </div>\n\n            <div className=\"space-y-2 pt-2 border-t border-slate-800/80 text-xs\">\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Migration Schema</span>\n                <span className=\"text-slate-200 font-mono\">001_initial_schema.sql</span>\n              </div>\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Defined Tables</span>\n                <span className=\"text-slate-200 font-mono\">10 Relational Tables</span>\n              </div>\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Security Extensions</span>\n                <span className=\"text-slate-200 font-mono\">uuid-ossp, pgcrypto</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Card 3: Redis Event Bus */}\n          <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"p-2.5 rounded-lg bg-rose-950/60 border border-rose-800/50 text-rose-400\">\n                  <Radio className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-semibold text-slate-200\">Redis 7</h3>\n                  <p className=\"text-xs text-slate-400\">Event Stream & Pub/Sub Bus</p>\n                </div>\n              </div>\n              <span className=\"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-rose-950 text-rose-400 border border-rose-800\">\n                Configured\n              </span>\n            </div>\n\n            <div className=\"space-y-2 pt-2 border-t border-slate-800/80 text-xs\">\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Stream Key</span>\n                <span className=\"text-slate-200 font-mono\">pg:stream:events</span>\n              </div>\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Consumer Group</span>\n                <span className=\"text-slate-200 font-mono\">pg-event-dispatchers</span>\n              </div>\n              <div className=\"flex justify-between text-slate-400\">\n                <span>Delivery Guarantee</span>\n                <span className=\"text-slate-200 font-mono\">At-Least-Once (XACK)</span>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Tab Navigation */}\n        <div className=\"flex items-center gap-2 border-b border-slate-800\">\n          <button\n            id=\"tab-overview\"\n            onClick={() => setActiveTab(\'overview\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition ${\n              activeTab === \'overview\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Layers className=\"w-4 h-4\" />\n              <span>Architecture Model</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-schema\"\n            onClick={() => setActiveTab(\'schema\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition ${\n              activeTab === \'schema\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Database className=\"w-4 h-4\" />\n              <span>Database Schema (10 Tables)</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-security\"\n            onClick={() => setActiveTab(\'security\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition ${\n              activeTab === \'security\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Lock className=\"w-4 h-4\" />\n              <span>Security & Privilege Model</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-prober\"\n            onClick={() => setActiveTab(\'prober\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition ${\n              activeTab === \'prober\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Activity className=\"w-4 h-4\" />\n              <span>Live API Health Prober</span>\n            </div>\n          </button>\n        </div>\n\n        {/* Tab 1: Architecture Model */}\n        {activeTab === \'overview\' && (\n          <div className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Shield className=\"w-4 h-4 text-cyan-400\" />\n                  <span>Data Plane vs. Control Plane Separation</span>\n                </h3>\n                <p className=\"text-sm text-slate-300 leading-relaxed\">\n                  Privacy Gateway isolates high-throughput WireGuard UDP network routing completely from the web and API control plane. The VPN data plane does not touch the database, eliminating browsing-history storage risks at the architectural level.\n                </p>\n                <div className=\"space-y-2 pt-2 text-xs\">\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                    <div>\n                      <span className=\"font-semibold text-slate-200\">Data Plane (WireGuard Kernel Node):</span>\n                      <p className=\"text-slate-400 mt-0.5\">Linux host kernel module (`wg0`), `nftables` NAT masquerading, and internal CoreDNS recursive resolver.</p>\n                    </div>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" />\n                    <div>\n                      <span className=\"font-semibold text-slate-200\">Control Plane (API & Privacy Engine):</span>\n                      <p className=\"text-slate-400 mt-0.5\">Non-root Express API handling device sessions, OIDC validation, and deterministic privacy analysis.</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Cpu className=\"w-4 h-4 text-blue-400\" />\n                  <span>Monorepo Workspace Hierarchy</span>\n                </h3>\n                <p className=\"text-sm text-slate-300 leading-relaxed\">\n                  Engineered with strict package boundaries so client applications, backend services, and cryptographic utilities remain decoupled:\n                </p>\n                <div className=\"font-mono text-xs text-slate-300 bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-1.5\">\n                  <div className=\"text-cyan-400\">apps/</div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\234\342\224\200\342\224\200 api/ <span className=\"text-slate-500\">(Express, Health Probes, Zod Env)</span></div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\224\342\224\200\342\224\200 web/ <span className=\"text-slate-500\">(React 19 Dashboard UI)</span></div>\n                  <div className=\"text-blue-400 pt-1\">packages/</div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\224\342\224\200\342\224\200 shared-types/ <span className=\"text-slate-500\">(API Contracts, DB Entities)</span></div>\n                  <div className=\"text-emerald-400 pt-1\">infrastructure/</div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\224\342\224\200\342\224\200 migrations/ <span className=\"text-slate-500\">(Transactional SQL Runner)</span></div>\n                </div>\n              </div>\n            </div>\n\n            {/* Development Roadmap Cards */}\n            <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n              <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                <Clock className=\"w-4 h-4 text-slate-400\" />\n                <span>Incremental Roadmap Status</span>\n              </h3>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs\">\n                <div className=\"p-3 rounded-lg bg-emerald-950/40 border border-emerald-800/80 text-emerald-300\">\n                  <div className=\"font-semibold flex items-center justify-between\">\n                    <span>Phase 1: Foundation</span>\n                    <span className=\"px-1.5 py-0.5 rounded bg-emerald-900 text-[10px]\">CURRENT</span>\n                  </div>\n                  <p className=\"text-emerald-400/80 mt-1\">Monorepo, Docker, Postgres DDL, Health Probes, Non-root Config.</p>\n                </div>\n                <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 text-slate-400\">\n                  <div className=\"font-semibold text-slate-200\">Phase 2: Google OIDC PKCE</div>\n                  <p className=\"text-slate-500 mt-1\">RFC 8252 Loopback + Web token exchange and JWT session rotation.</p>\n                </div>\n                <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 text-slate-400\">\n                  <div className=\"font-semibold text-slate-200\">Phase 3: WireGuard Server</div>\n                  <p className=\"text-slate-500 mt-1\">Kernel Netlink daemon, IP allocation, and nftables NAT masquerade.</p>\n                </div>\n                <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 text-slate-400\">\n                  <div className=\"font-semibold text-slate-200\">Phase 4+: Client & Prober</div>\n                  <p className=\"text-slate-500 mt-1\">Tauri desktop client, MV3 extension, and deterministic scoring.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 2: Database Schema */}\n        {activeTab === \'schema\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <div>\n                  <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                    <Database className=\"w-4 h-4 text-cyan-400\" />\n                    <span>PostgreSQL 16 Relational Schema (001_initial_schema.sql)</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1\">\n                    Normalized relational model supporting devices, peers, sessions, and immutable audit trails with zero plaintext secrets.\n                  </p>\n                </div>\n                <span className=\"px-2.5 py-1 text-xs rounded-lg bg-slate-800 text-cyan-400 font-mono border border-slate-700\">\n                  10 Core Tables Defined\n                </span>\n              </div>\n\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-left text-xs text-slate-300\">\n                  <thead className=\"bg-slate-950 text-slate-400 uppercase tracking-wider border-b border-slate-800\">\n                    <tr>\n                      <th className=\"py-3 px-4\">Table Name</th>\n                      <th className=\"py-3 px-4\">Functional Role</th>\n                      <th className=\"py-3 px-4\">Key Constraints & Indexes</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-800/60 font-mono\">\n                    {schemaTables.map((t) => (\n                      <tr key={t.name} className=\"hover:bg-slate-850/50\">\n                        <td className=\"py-3 px-4 font-semibold text-cyan-300\">{t.name}</td>\n                        <td className=\"py-3 px-4 font-sans text-slate-300\">{t.role}</td>\n                        <td className=\"py-3 px-4 text-slate-400\">{t.keys}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 3: Security & Privilege Model */}\n        {activeTab === \'security\' && (\n          <div className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Lock className=\"w-4 h-4 text-emerald-400\" />\n                  <span>Docker Least-Privilege Implementation</span>\n                </h3>\n                <div className=\"space-y-3 text-xs text-slate-300\">\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-emerald-400\">Non-Root Execution:</span>\n                    <p className=\"text-slate-400\">The Node.js API container runs explicitly as unprivileged user <code className=\"text-cyan-300 font-mono\">UID 10001:10001 (appuser)</code>.</p>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-emerald-400\">Capabilities Dropped:</span>\n                    <p className=\"text-slate-400\"><code className=\"text-cyan-300 font-mono\">cap_drop: ALL</code> drops all kernel capabilities, preventing privilege escalation.</p>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-emerald-400\">Read-Only Root Filesystem:</span>\n                    <p className=\"text-slate-400\"><code className=\"text-cyan-300 font-mono\">read_only: true</code> enforces immutable container root, writing transient files only to explicit tmpfs mounts.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Shield className=\"w-4 h-4 text-blue-400\" />\n                  <span>Zero Browsing Logs Protocol</span>\n                </h3>\n                <div className=\"space-y-3 text-xs text-slate-300\">\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-blue-400\">What We NEVER Store:</span>\n                    <p className=\"text-slate-400\">Zero URLs, zero packet payloads, zero DNS query histories, and zero WireGuard private keys (generated locally on client devices).</p>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-blue-400\">Structured Request Logging:</span>\n                    <p className=\"text-slate-400\">Backend logging middleware records only method, path, status, and duration with request ID \342\200\224 stripping all query parameters and request bodies.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 4: Live API Health Prober */}\n        {activeTab === \'prober\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div>\n                  <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                    <Terminal className=\"w-4 h-4 text-cyan-400\" />\n                    <span>Interactive Backend Probe Console</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1\">\n                    Execute real HTTP GET calls against backend health and system endpoints to verify latency and payload integrity.\n                  </p>\n                </div>\n                <div className=\"flex flex-wrap items-center gap-2\">\n                  <button\n                    id=\"probe-health\"\n                    onClick={() => runProbe(\'/health\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /health\n                  </button>\n                  <button\n                    id=\"probe-live\"\n                    onClick={() => runProbe(\'/health/live\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-emerald-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /health/live\n                  </button>\n                  <button\n                    id=\"probe-system\"\n                    onClick={() => runProbe(\'/api/v1/system/info\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-blue-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /api/v1/system/info\n                  </button>\n                  <button\n                    id=\"probe-migrations\"\n                    onClick={() => runProbe(\'/api/v1/system/migrations\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-purple-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /api/v1/system/migrations\n                  </button>\n                </div>\n              </div>\n\n              {probeResult && (\n                <div className=\"mt-4 p-4 rounded-lg bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs\">\n                  <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-slate-400\">Endpoint:</span>\n                      <span className=\"text-cyan-400 font-semibold\">{probeResult.endpoint}</span>\n                    </div>\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"text-slate-400\">Roundtrip Latency: <strong className=\"text-emerald-400 font-normal\">{probeResult.latencyMs} ms</strong></span>\n                      <span className=\"px-2 py-0.5 rounded bg-slate-800 text-slate-200\">HTTP {probeResult.status}</span>\n                    </div>\n                  </div>\n                  <pre className=\"text-slate-300 overflow-x-auto p-2 bg-slate-900/60 rounded border border-slate-800/80\">\n                    {JSON.stringify(probeResult.data, null, 2)}\n                  </pre>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n"
    }
