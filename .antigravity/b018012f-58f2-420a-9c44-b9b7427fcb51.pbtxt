  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Shield,\n  Server,\n  Database,\n  Layers,\n  Activity,\n  CheckCircle2,\n  AlertTriangle,\n  RefreshCw,\n  Cpu,\n  Lock,\n  Terminal,\n  FileCode,\n  Radio,\n  Clock,\n  ArrowUpRight,\n  Zap,\n  Key,\n  UserCheck,\n  LogOut,\n  Trash2,\n  Smartphone,\n  Laptop,\n  Globe,\n  KeyRound,\n} from \'lucide-react\';\nimport {\n  HealthCheckResponse,\n  SystemInfoResponse,\n  UserProfileDto,\n  SessionItemDto,\n  AuthMeResponseDto,\n} from \'../packages/shared-types/src/api\';\n\nexport default function App() {\n  const [healthData, setHealthData] = useState<HealthCheckResponse | null>(null);\n  const [systemInfo, setSystemInfo] = useState<SystemInfoResponse | null>(null);\n  const [currentUser, setCurrentUser] = useState<UserProfileDto | null>(null);\n  const [sessions, setSessions] = useState<SessionItemDto[]>([]);\n  const [activeSessionId, setActiveSessionId] = useState<string | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const [authLoading, setAuthLoading] = useState(false);\n  const [lastRefreshed, setLastRefreshed] = useState<Date>(new Date());\n  const [activeTab, setActiveTab] = useState<\'auth\' | \'overview\' | \'schema\' | \'security\' | \'prober\'>(\'auth\');\n  const [probeResult, setProbeResult] = useState<{ endpoint: string; status: number; latencyMs: number; data: unknown } | null>(null);\n  const [probing, setProbing] = useState(false);\n  const [rbacMessage, setRbacMessage] = useState<string | null>(null);\n\n  // Read CSRF Token from document cookies\n  const getCsrfToken = (): string => {\n    const match = document.cookie.match(new RegExp(\'(^| )pg_csrf_token=([^;]+)\'));\n    return match ? match[2] : \'\';\n  };\n\n  const fetchCurrentUser = async () => {\n    try {\n      const res = await fetch(\'/api/v1/auth/me\');\n      if (res.ok) {\n        const json = await res.json();\n        setCurrentUser(json.data.user);\n        setActiveSessionId(json.data.sessionId);\n        fetchSessions();\n      } else {\n        setCurrentUser(null);\n        setSessions([]);\n      }\n    } catch {\n      setCurrentUser(null);\n    }\n  };\n\n  const fetchSessions = async () => {\n    try {\n      const res = await fetch(\'/api/v1/auth/sessions\');\n      if (res.ok) {\n        const json = await res.json();\n        setSessions(json.data || []);\n      }\n    } catch {\n      // ignore\n    }\n  };\n\n  const fetchHealthAndSystem = async () => {\n    setIsLoading(true);\n    try {\n      const [healthRes, systemRes] = await Promise.all([\n        fetch(\'/health\'),\n        fetch(\'/api/v1/system/info\'),\n      ]);\n\n      if (healthRes.ok) {\n        const hData = await healthRes.json();\n        setHealthData(hData);\n      }\n      if (systemRes.ok) {\n        const sData = await systemRes.json();\n        setSystemInfo(sData.data);\n      }\n      setLastRefreshed(new Date());\n    } catch (err) {\n      console.error(\'Error fetching telemetry:\', err);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchHealthAndSystem();\n    fetchCurrentUser();\n    const interval = setInterval(fetchHealthAndSystem, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleStartGoogleLogin = () => {\n    window.location.href = \'/api/v1/auth/google/start\';\n  };\n\n  const handleLogout = async () => {\n    setAuthLoading(true);\n    try {\n      const csrfToken = getCsrfToken();\n      await fetch(\'/api/v1/auth/logout\', {\n        method: \'POST\',\n        headers: {\n          \'X-CSRF-Token\': csrfToken,\n        },\n      });\n      setCurrentUser(null);\n      setSessions([]);\n    } catch (err) {\n      console.error(\'Logout error:\', err);\n    } finally {\n      setAuthLoading(false);\n    }\n  };\n\n  const handleRotateRefreshToken = async () => {\n    setAuthLoading(true);\n    try {\n      const csrfToken = getCsrfToken();\n      const res = await fetch(\'/api/v1/auth/refresh\', {\n        method: \'POST\',\n        headers: {\n          \'X-CSRF-Token\': csrfToken,\n        },\n      });\n      if (res.ok) {\n        const json = await res.json();\n        setCurrentUser(json.data.user);\n        await fetchSessions();\n        alert(\'Refresh Token rotated successfully within Token Family.\');\n      } else {\n        const json = await res.json();\n        alert(`Refresh error: ${json.error?.message || \'Failed\'}`);\n      }\n    } catch (err) {\n      alert(`Network error: ${(err as Error).message}`);\n    } finally {\n      setAuthLoading(false);\n    }\n  };\n\n  const handleRevokeSession = async (sessionId: string) => {\n    try {\n      const csrfToken = getCsrfToken();\n      const res = await fetch(`/api/v1/auth/sessions/${sessionId}`, {\n        method: \'DELETE\',\n        headers: {\n          \'X-CSRF-Token\': csrfToken,\n        },\n      });\n      if (res.ok) {\n        fetchSessions();\n      }\n    } catch (err) {\n      console.error(\'Error revoking session:\', err);\n    }\n  };\n\n  const testAdminRbac = async () => {\n    setRbacMessage(null);\n    try {\n      const res = await fetch(\'/api/v1/admin/users\');\n      const json = await res.json();\n      if (res.ok) {\n        setRbacMessage(`200 OK: User is Admin. Retrieved ${json.data.total} user records.`);\n      } else {\n        setRbacMessage(`HTTP ${res.status}: ${json.error?.message || \'Access Denied (RBAC Protected)\'}`);\n      }\n    } catch (err) {\n      setRbacMessage(`Network error: ${(err as Error).message}`);\n    }\n  };\n\n  const runProbe = async (endpoint: string) => {\n    setProbing(true);\n    const start = performance.now();\n    try {\n      const res = await fetch(endpoint);\n      const latency = Math.round(performance.now() - start);\n      const data = await res.json();\n      setProbeResult({\n        endpoint,\n        status: res.status,\n        latencyMs: latency,\n        data,\n      });\n    } catch (err) {\n      const latency = Math.round(performance.now() - start);\n      setProbeResult({\n        endpoint,\n        status: 500,\n        latencyMs: latency,\n        data: { error: (err as Error).message },\n      });\n    } finally {\n      setProbing(false);\n    }\n  };\n\n  const schemaTables = [\n    { name: \'users\', role: \'Core identity records, data retention limits, and active status flags\', keys: \'PK: id (UUID), UK: email\' },\n    { name: \'authentication_accounts\', role: \'OIDC / Google OAuth linked accounts and provider subjects\', keys: \'PK: id, FK: user_id, UK: (provider, provider_subject_id)\' },\n    { name: \'user_sessions\', role: \'CSPRNG refresh token hashes and token family IDs\', keys: \'PK: id, FK: user_id, UK: refresh_token_hash, IDX: family_id\' },\n    { name: \'session_token_history\', role: \'Audit trail of rotated refresh token hashes to detect replay theft\', keys: \'PK: id, FK: session_id, IDX: token_hash\' },\n    { name: \'devices\', role: \'Hardware devices, OS platforms, and client application versions\', keys: \'PK: id, FK: user_id\' },\n    { name: \'vpn_servers\', role: \'WireGuard infrastructure nodes, CIDR pools, and health state\', keys: \'PK: id, UK: public_endpoint\' },\n    { name: \'wireguard_peers\', role: \'Curve25519 public keys and allocated IPv4/IPv6 addresses\', keys: \'PK: id, FK: user_id, FK: vpn_server_id, UK: public_key\' },\n    { name: \'subscriptions\', role: \'Plan tiers (Free/Premium/Business), limits, and billing status\', keys: \'PK: id, FK: user_id\' },\n    { name: \'privacy_scans\', role: \'Deterministic 4-pillar privacy scores & diagnostic snapshots\', keys: \'PK: id, FK: user_id\' },\n    { name: \'privacy_events\', role: \'Configurable retention stream for tracker & diagnostic alerts\', keys: \'PK: id, FK: user_id\' },\n    { name: \'audit_logs\', role: \'Immutable security event log with actor and target records\', keys: \'PK: id, FK: actor_user_id\' },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cyan-500/20 selection:text-cyan-300\">\n      {/* Top Header */}\n      <header className=\"border-b border-slate-800 bg-slate-900/60 backdrop-blur-md sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/20\">\n              <Shield className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-lg font-semibold tracking-tight text-white\">Privacy Gateway</h1>\n                <span className=\"px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800/60\">\n                  Phase 2 OIDC / Auth Ready\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">Zero-Log Architecture & Token Family Security</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-4\">\n            {currentUser ? (\n              <div className=\"flex items-center gap-3 bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5\">\n                <div className=\"w-6 h-6 rounded-full bg-cyan-600 flex items-center justify-center text-xs font-semibold text-white\">\n                  {currentUser.displayName ? currentUser.displayName[0] : currentUser.email[0].toUpperCase()}\n                </div>\n                <div className=\"hidden sm:block text-left\">\n                  <div className=\"text-xs font-medium text-slate-200\">{currentUser.email}</div>\n                  <div className=\"text-[10px] text-cyan-400 uppercase font-semibold\">{currentUser.role}</div>\n                </div>\n                <button\n                  id=\"logout-btn\"\n                  onClick={handleLogout}\n                  disabled={authLoading}\n                  className=\"p-1 text-slate-400 hover:text-rose-400 transition\"\n                  title=\"Log out\"\n                >\n                  <LogOut className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ) : (\n              <button\n                id=\"header-login-btn\"\n                onClick={handleStartGoogleLogin}\n                className=\"flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-500 active:bg-blue-700 rounded-lg shadow-sm transition\"\n              >\n                <Key className=\"w-3.5 h-3.5\" />\n                <span>Sign in with Google</span>\n              </button>\n            )}\n\n            <button\n              id=\"refresh-btn\"\n              onClick={fetchHealthAndSystem}\n              disabled={isLoading}\n              className=\"flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium text-slate-200 bg-slate-800 hover:bg-slate-700 active:bg-slate-900 rounded-lg border border-slate-700 transition disabled:opacity-50\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? \'animate-spin text-cyan-400\' : \'\'}`} />\n              <span className=\"hidden sm:inline\">Refresh</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n        {/* Navigation Tabs */}\n        <div className=\"flex items-center gap-2 border-b border-slate-800 overflow-x-auto\">\n          <button\n            id=\"tab-auth\"\n            onClick={() => setActiveTab(\'auth\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition whitespace-nowrap ${\n              activeTab === \'auth\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <KeyRound className=\"w-4 h-4\" />\n              <span>Authentication & Sessions</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-overview\"\n            onClick={() => setActiveTab(\'overview\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition whitespace-nowrap ${\n              activeTab === \'overview\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Layers className=\"w-4 h-4\" />\n              <span>Architecture Model</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-schema\"\n            onClick={() => setActiveTab(\'schema\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition whitespace-nowrap ${\n              activeTab === \'schema\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Database className=\"w-4 h-4\" />\n              <span>Database Schema (11 Tables)</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-security\"\n            onClick={() => setActiveTab(\'security\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition whitespace-nowrap ${\n              activeTab === \'security\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Lock className=\"w-4 h-4\" />\n              <span>Security & Token Lifecycle</span>\n            </div>\n          </button>\n          <button\n            id=\"tab-prober\"\n            onClick={() => setActiveTab(\'prober\')}\n            className={`px-4 py-2.5 text-sm font-medium border-b-2 transition whitespace-nowrap ${\n              activeTab === \'prober\'\n                ? \'border-cyan-400 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Activity className=\"w-4 h-4\" />\n              <span>API Health & Prober</span>\n            </div>\n          </button>\n        </div>\n\n        {/* Tab 0: Authentication & Session Console */}\n        {activeTab === \'auth\' && (\n          <div className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n              {/* User Profile Card */}\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                    <UserCheck className=\"w-4 h-4 text-cyan-400\" />\n                    <span>Identity Status</span>\n                  </h3>\n                  <span className={`px-2 py-0.5 text-xs rounded-full font-medium ${\n                    currentUser\n                      ? \'bg-emerald-950 text-emerald-400 border border-emerald-800\'\n                      : \'bg-slate-800 text-slate-400\'\n                  }`}>\n                    {currentUser ? \'Authenticated\' : \'Anonymous\'}\n                  </span>\n                </div>\n\n                {currentUser ? (\n                  <div className=\"space-y-3 text-xs\">\n                    <div className=\"p-3 bg-slate-950 border border-slate-800 rounded-lg space-y-2\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-400\">Email:</span>\n                        <span className=\"text-slate-200 font-semibold\">{currentUser.email}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-400\">Assigned Role:</span>\n                        <span className=\"text-cyan-400 uppercase font-semibold\">{currentUser.role}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-400\">User ID:</span>\n                        <span className=\"text-slate-400 font-mono text-[11px] truncate max-w-[160px]\">{currentUser.id}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-400\">Data Retention:</span>\n                        <span className=\"text-slate-200\">{currentUser.dataRetentionDays} Days</span>\n                      </div>\n                    </div>\n\n                    <div className=\"pt-2 flex flex-col gap-2\">\n                      <button\n                        id=\"rotate-token-btn\"\n                        onClick={handleRotateRefreshToken}\n                        disabled={authLoading}\n                        className=\"w-full py-2 px-3 bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded-lg text-xs font-medium border border-slate-700 transition flex items-center justify-center gap-2\"\n                      >\n                        <RefreshCw className={`w-3.5 h-3.5 ${authLoading ? \'animate-spin\' : \'\'}`} />\n                        <span>Rotate Refresh Token (Token Family)</span>\n                      </button>\n\n                      <button\n                        id=\"test-rbac-btn\"\n                        onClick={testAdminRbac}\n                        className=\"w-full py-2 px-3 bg-slate-800 hover:bg-slate-700 text-purple-400 rounded-lg text-xs font-medium border border-slate-700 transition flex items-center justify-center gap-2\"\n                      >\n                        <Lock className=\"w-3.5 h-3.5\" />\n                        <span>Probe Admin RBAC Boundary</span>\n                      </button>\n                    </div>\n\n                    {rbacMessage && (\n                      <div className=\"p-2.5 bg-slate-950 border border-slate-800 rounded text-xs font-mono text-purple-300\">\n                        {rbacMessage}\n                      </div>\n                    )}\n                  </div>\n                ) : (\n                  <div className=\"text-center py-6 space-y-4\">\n                    <p className=\"text-xs text-slate-400 leading-relaxed\">\n                      Sign in using Google OpenID Connect (PKCE S256). In development mode with placeholder credentials, you can simulate authorization or configure real Google credentials in <code className=\"text-cyan-300 font-mono\">.env</code>.\n                    </p>\n                    <button\n                      id=\"google-login-main\"\n                      onClick={handleStartGoogleLogin}\n                      className=\"w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white rounded-lg text-xs font-medium shadow-md shadow-blue-600/20 transition flex items-center justify-center gap-2\"\n                    >\n                      <Globe className=\"w-4 h-4\" />\n                      <span>Initiate Google OAuth 2.0 (PKCE)</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n\n              {/* Active Sessions List */}\n              <div className=\"lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                      <Laptop className=\"w-4 h-4 text-blue-400\" />\n                      <span>Active Sessions & Token Families</span>\n                    </h3>\n                    <p className=\"text-xs text-slate-400 mt-0.5\">\n                      Real-time session monitoring with IP minimization. Client IP is never stored.\n                    </p>\n                  </div>\n                  <span className=\"px-2 py-0.5 text-xs bg-slate-800 text-slate-300 rounded font-mono\">\n                    {sessions.length} Active\n                  </span>\n                </div>\n\n                {sessions.length > 0 ? (\n                  <div className=\"space-y-2\">\n                    {sessions.map((sess) => (\n                      <div\n                        key={sess.id}\n                        className={`p-3.5 rounded-lg border text-xs flex items-center justify-between ${\n                          sess.isCurrent\n                            ? \'bg-slate-950 border-cyan-800/80 shadow-sm shadow-cyan-950/20\'\n                            : \'bg-slate-950/60 border-slate-800\'\n                        }`}\n                      >\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-semibold text-slate-200\">\n                              {sess.userAgent || \'Web Client\'}\n                            </span>\n                            {sess.isCurrent && (\n                              <span className=\"px-1.5 py-0.2 rounded bg-cyan-950 text-cyan-400 text-[10px] border border-cyan-800 font-medium\">\n                                Current Session\n                              </span>\n                            )}\n                          </div>\n                          <div className=\"text-[11px] text-slate-400 font-mono space-x-3\">\n                            <span>Family ID: {sess.familyId.substring(0, 8)}...</span>\n                            <span>Last Used: {new Date(sess.lastUsedAt).toLocaleTimeString()}</span>\n                          </div>\n                        </div>\n\n                        <div>\n                          {!sess.isCurrent && (\n                            <button\n                              onClick={() => handleRevokeSession(sess.id)}\n                              className=\"p-1.5 text-slate-400 hover:text-rose-400 transition rounded hover:bg-slate-900\"\n                              title=\"Revoke session\"\n                            >\n                              <Trash2 className=\"w-4 h-4\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"p-8 text-center bg-slate-950 rounded-lg border border-slate-800/60 text-xs text-slate-500\">\n                    No active sessions found. Sign in to view and manage active session families.\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 1: Architecture Model */}\n        {activeTab === \'overview\' && (\n          <div className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Shield className=\"w-4 h-4 text-cyan-400\" />\n                  <span>Data Plane vs. Control Plane Separation</span>\n                </h3>\n                <p className=\"text-sm text-slate-300 leading-relaxed\">\n                  Privacy Gateway isolates high-throughput WireGuard UDP network routing completely from the web and API control plane. The VPN data plane does not touch the database, eliminating browsing-history storage risks at the architectural level.\n                </p>\n                <div className=\"space-y-2 pt-2 text-xs\">\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                    <div>\n                      <span className=\"font-semibold text-slate-200\">Data Plane (WireGuard Kernel Node):</span>\n                      <p className=\"text-slate-400 mt-0.5\">Linux host kernel module (`wg0`), `nftables` NAT masquerading, and internal CoreDNS recursive resolver.</p>\n                    </div>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" />\n                    <div>\n                      <span className=\"font-semibold text-slate-200\">Control Plane (API & Privacy Engine):</span>\n                      <p className=\"text-slate-400 mt-0.5\">Non-root Express API handling device sessions, OIDC validation, and deterministic privacy analysis.</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Cpu className=\"w-4 h-4 text-blue-400\" />\n                  <span>Monorepo Workspace Hierarchy</span>\n                </h3>\n                <p className=\"text-sm text-slate-300 leading-relaxed\">\n                  Engineered with strict package boundaries so client applications, backend services, and cryptographic utilities remain decoupled:\n                </p>\n                <div className=\"font-mono text-xs text-slate-300 bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-1.5\">\n                  <div className=\"text-cyan-400\">apps/</div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\234\342\224\200\342\224\200 api/ <span className=\"text-slate-500\">(Express, RS256 Auth, Health Probes)</span></div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\224\342\224\200\342\224\200 web/ <span className=\"text-slate-500\">(React 19 Dashboard UI)</span></div>\n                  <div className=\"text-blue-400 pt-1\">packages/</div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\224\342\224\200\342\224\200 shared-types/ <span className=\"text-slate-500\">(API Contracts, Auth DTOs)</span></div>\n                  <div className=\"text-emerald-400 pt-1\">infrastructure/</div>\n                  <div className=\"pl-4 text-slate-300\">\342\224\224\342\224\200\342\224\200 migrations/ <span className=\"text-slate-500\">(001_initial_schema, 002_auth_token_families)</span></div>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 2: Database Schema */}\n        {activeTab === \'schema\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <div>\n                  <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                    <Database className=\"w-4 h-4 text-cyan-400\" />\n                    <span>PostgreSQL 16 Relational Schema (Phase 1 & Phase 2)</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1\">\n                    Normalized relational model supporting token family replay protection and complete IP minimization.\n                  </p>\n                </div>\n                <span className=\"px-2.5 py-1 text-xs rounded-lg bg-slate-800 text-cyan-400 font-mono border border-slate-700\">\n                  11 Core Tables Defined\n                </span>\n              </div>\n\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-left text-xs text-slate-300\">\n                  <thead className=\"bg-slate-950 text-slate-400 uppercase tracking-wider border-b border-slate-800\">\n                    <tr>\n                      <th className=\"py-3 px-4\">Table Name</th>\n                      <th className=\"py-3 px-4\">Functional Role</th>\n                      <th className=\"py-3 px-4\">Key Constraints & Indexes</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-800/60 font-mono\">\n                    {schemaTables.map((t) => (\n                      <tr key={t.name} className=\"hover:bg-slate-850/50\">\n                        <td className=\"py-3 px-4 font-semibold text-cyan-300\">{t.name}</td>\n                        <td className=\"py-3 px-4 font-sans text-slate-300\">{t.role}</td>\n                        <td className=\"py-3 px-4 text-slate-400\">{t.keys}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 3: Security & Token Lifecycle */}\n        {activeTab === \'security\' && (\n          <div className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <KeyRound className=\"w-4 h-4 text-emerald-400\" />\n                  <span>RS256 JWT & Token Family Architecture</span>\n                </h3>\n                <div className=\"space-y-3 text-xs text-slate-300\">\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-emerald-400\">15-Minute Asymmetric RS256 Access Tokens:</span>\n                    <p className=\"text-slate-400\">Stateless RS256 signature verification allows horizontal API scaling without database lookups on every request.</p>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-emerald-400\">Atomic Refresh Token Rotation (Approach A):</span>\n                    <p className=\"text-slate-400\">Refresh tokens are stored solely as SHA-256 hashes. Each refresh generates a new hash and invalidates the previous token.</p>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-emerald-400\">Replay Attack Family Revocation:</span>\n                    <p className=\"text-slate-400\">If an already-rotated token is submitted again, the entire token family is instantaneously revoked and an audit event is triggered.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n                <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                  <Shield className=\"w-4 h-4 text-blue-400\" />\n                  <span>Double-Submit CSRF & Native Desktop Model</span>\n                </h3>\n                <div className=\"space-y-3 text-xs text-slate-300\">\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-blue-400\">Constant-Time Double-Submit CSRF:</span>\n                    <p className=\"text-slate-400\">Every cookie-authenticated mutation (including <code className=\"text-cyan-300 font-mono\">/auth/refresh</code>) validates <code className=\"text-cyan-300 font-mono\">X-CSRF-Token</code> against <code className=\"text-cyan-300 font-mono\">pg_csrf_token</code> using <code className=\"text-cyan-300 font-mono\">crypto.timingSafeEqual</code>.</p>\n                  </div>\n                  <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-1\">\n                    <span className=\"font-semibold text-blue-400\">RFC 8252 Desktop Native Contract:</span>\n                    <p className=\"text-slate-400\">Desktop clients authenticate via local loopback sockets (<code className=\"text-cyan-300 font-mono\">127.0.0.1</code>) and exchange PKCE tokens without embedded client secrets.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 4: API Health Prober */}\n        {activeTab === \'prober\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                <div>\n                  <h3 className=\"text-base font-semibold text-slate-100 flex items-center gap-2\">\n                    <Terminal className=\"w-4 h-4 text-cyan-400\" />\n                    <span>Interactive Backend Probe Console</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-400 mt-1\">\n                    Execute live HTTP GET calls against health, system, and authentication endpoints.\n                  </p>\n                </div>\n                <div className=\"flex flex-wrap items-center gap-2\">\n                  <button\n                    id=\"probe-health\"\n                    onClick={() => runProbe(\'/health\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /health\n                  </button>\n                  <button\n                    id=\"probe-system\"\n                    onClick={() => runProbe(\'/api/v1/system/info\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-blue-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /api/v1/system/info\n                  </button>\n                  <button\n                    id=\"probe-auth-me\"\n                    onClick={() => runProbe(\'/api/v1/auth/me\')}\n                    disabled={probing}\n                    className=\"px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-emerald-400 rounded-lg border border-slate-700 transition\"\n                  >\n                    Probe /api/v1/auth/me\n                  </button>\n                </div>\n              </div>\n\n              {probeResult && (\n                <div className=\"mt-4 p-4 rounded-lg bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs\">\n                  <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-slate-400\">Endpoint:</span>\n                      <span className=\"text-cyan-400 font-semibold\">{probeResult.endpoint}</span>\n                    </div>\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"text-slate-400\">Roundtrip Latency: <strong className=\"text-emerald-400 font-normal\">{probeResult.latencyMs} ms</strong></span>\n                      <span className=\"px-2 py-0.5 rounded bg-slate-800 text-slate-200\">HTTP {probeResult.status}</span>\n                    </div>\n                  </div>\n                  <pre className=\"text-slate-300 overflow-x-auto p-2 bg-slate-900/60 rounded border border-slate-800/80\">\n                    {JSON.stringify(probeResult.data, null, 2)}\n                  </pre>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n"
    }
