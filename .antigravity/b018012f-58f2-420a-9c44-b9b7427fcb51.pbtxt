        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Quickstart & Local Setup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Prerequisites"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Node.js 20+ / 22+"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Docker & Docker Compose"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 1: Clone and Configure Environment"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "cp .env.example .env"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 2: Start with Docker Compose (Recommended)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "docker-compose up -d --build"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This boots:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. `pg_database` (PostgreSQL 16 on `localhost:5432` with `001_initial_schema.sql` pre-loaded)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. `pg_redis` (Redis 7 on `localhost:6379`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. `pg_api` (Privacy Gateway API on `http://localhost:3000`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 3: Run Standalone Development (Host Mode)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "npm install"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "npm run dev"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Unified development server boots on `http://localhost:3000` hosting both the Express API routes and the Vite web dashboard."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 4. Database Migrations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The transactional migration engine inspects `_migrations` and applies pending `.sql` files within discrete transactions:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "npm run migrate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Core Tables Created (Phase 1):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. `users` \342\200\224 Primary account records and configurable retention limits (1\342\200\223365 days)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. `authentication_accounts` \342\200\224 OIDC / Google OAuth linked accounts."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. `user_sessions` \342\200\224 Refresh token hashes and anonymized client IP prefixes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. `devices` \342\200\224 Registered desktop and mobile client instances."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. `vpn_servers` \342\200\224 WireGuard infrastructure node endpoints and CIDRs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "6. `wireguard_peers` \342\200\224 Curve25519 public keys and allocated VPN IPs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "7. `subscriptions` \342\200\224 Plan tiers (Free, Premium, Business) and device quotas."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "8. `privacy_scans` \342\200\224 Deterministic 4-pillar privacy scores and explanations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "9. `privacy_events` \342\200\224 Configurable retention stream for tracker and leak events."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "10. `audit_logs` \342\200\224 Immutable security event log."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 5. Health Endpoints & Live Probing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Endpoint | Method | Purpose |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| :--- | :--- | :--- |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `/health` | `GET` | Full diagnostic probe measuring PostgreSQL & Redis latency, memory RSS/heap, and uptime. |"
