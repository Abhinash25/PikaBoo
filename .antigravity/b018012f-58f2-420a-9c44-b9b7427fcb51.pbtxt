    replacement_chunks {
      replacement_content: "import { Request, Response } from \'express\';\nimport { getDatabasePool } from \'../config/database\';\n\nexport class AdminController {\n  /**\n   * GET /api/v1/admin/users\n   * Strict RBAC Test Endpoint: lists users (Admin role only)\n   */\n  static async listUsers(req: Request, res: Response) {\n    const pool = getDatabasePool();\n    try {\n      const result = await pool.query(\n        `SELECT id, email, display_name, role, is_active, data_retention_days, created_at\n         FROM users\n         ORDER BY created_at DESC\n         LIMIT 50`\n      );\n\n      return res.json({\n        success: true,\n        data: {\n          users: result.rows,\n          total: result.rowCount,\n          requestedBy: {\n            id: req.user?.sub,\n            role: req.user?.role,\n          },\n        },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-admin\',\n      });\n    } catch (err) {\n      return res.status(500).json({\n        success: false,\n        error: { code: \'DATABASE_ERROR\', message: (err as Error).message },\n        timestamp: new Date().toISOString(),\n        requestId: (req as any).id || \'req-admin\',\n      });\n    }\n  }\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import { Request, Response } from \'express\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { getDatabasePool } from \'../config/database\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
