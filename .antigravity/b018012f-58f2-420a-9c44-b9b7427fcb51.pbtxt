    absolute_path_uri: "file:///apps/api/src/services/auth.service.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { getDatabasePool } from \'../config/database\';\nimport { getRedisClient } from \'../config/redis\';\nimport { getEnv } from \'../config/env\';\nimport {\n  generateAccessToken,\n  generateRefreshToken,\n  generateCsrfToken,\n  hashToken,\n} from \'./token.service\';\nimport { verifyGoogleIdToken, GoogleIdTokenClaims } from \'./oidc.service\';\nimport { UserRole, UserProfileDto, SessionItemDto } from \'@privacy-gateway/shared-types\';\nimport crypto from \'node:crypto\';\n\nexport interface OAuthTransactionData {\n  nonce: string;\n  codeVerifier: string;\n  returnTo: string;\n  createdAt: number;\n}\n\nexport interface AuthSuccessResult {\n  accessToken: string;\n  refreshToken: string;\n  csrfToken: string;\n  user: UserProfileDto;\n  sessionId: string;\n}\n\nexport interface OAuthDiagnosticEvent {\n  step:\n    | \'OAUTH_START\'\n    | \'REDIS_STATE\'\n    | \'GOOGLE_AUTH_URL\'\n    | \'CALLBACK_RECEIVED\'\n    | \'TOKEN_EXCHANGE\'\n    | \'OIDC_VERIFY\'\n    | \'DB_IDENTITY\'\n    | \'SESSION_CREATE\'\n    | \'COOKIES_ISSUED\'\n    | \'AUTH_ME\';\n  status: \'PASS\' | \'FAIL\' | \'INFO\';\n  category?: string;\n  details?: string;\n  timestamp: string;\n}\n\n// In-memory fallback stores for single-instance or local development when external services are offline\nconst inMemoryOAuthStates = new Map<string, { data: OAuthTransactionData; expiresAt: number }>();\nconst diagnosticEvents: OAuthDiagnosticEvent[] = [];\n\n// Fallback in-memory relational tables for local sandbox resilience\ninterface InMemoryUser {\n  id: string;\n  email: string;\n  display_name: string | null;\n  avatar_url: string | null;\n  role: UserRole;\n  is_active: boolean;\n  data_retention_days: number;\n  created_at: Date;\n}\n\ninterface InMemoryAuthAccount {\n  id: string;\n  user_id: string;\n  provider: string;\n  provider_subject_id: string;\n  email_at_provider: string;\n}\n\ninterface InMemorySession {\n  id: string;\n  user_id: string;\n  family_id: string;\n  refresh_token_hash: string;\n  user_agent: string | null;\n  created_at: Date;\n  last_used_at: Date;\n  expires_at: Date;\n  revoked_at: Date | null;\n}\n\ninterface InMemoryTokenHistory {\n  id: string;\n  session_id: string;\n  family_id: string;\n  token_hash: string;\n  created_at: Date;\n}\n\nconst memoryDb = {\n  users: new Map<string, InMemoryUser>(),\n  authAccounts: new Map<string, InMemoryAuthAccount>(),\n  sessions: new Map<string, InMemorySession>(),\n  tokenHistory: [] as InMemoryTokenHistory[],\n};\n\nexport class AuthService {\n  /**\n   * Safe diagnostic recording (Never logs secrets, tokens, codes, or keys)\n   */\n  static recordDiagnostic(event: Omit<OAuthDiagnosticEvent, \'timestamp\'>) {\n    const fullEvent: OAuthDiagnosticEvent = {\n      ...event,\n      timestamp: new Date().toISOString(),\n    };\n    diagnosticEvents.push(fullEvent);\n    if (diagnosticEvents.length > 50) {\n      diagnosticEvents.shift();\n    }\n  }\n\n  /**\n   * Retrieve safe diagnostics history\n   */\n  static getDiagnostics(): OAuthDiagnosticEvent[] {\n    return [...diagnosticEvents];\n  }\n\n  /**\n   * Store OAuth state in Redis (5 min TTL) with in-memory fallback\n   */\n  static async saveOAuthState(state: string, data: OAuthTransactionData): Promise<void> {\n    // 1. In-memory TTL backup\n    inMemoryOAuthStates.set(state, {\n      data,\n      expiresAt: Date.now() + 300 * 1000,\n    });\n\n    // 2. Redis if connected\n    try {\n      const redis = getRedisClient();\n      if (redis && redis.status === \'ready\') {\n        await redis.set(`pg:oauth:state:${state}`, JSON.stringify(data), \'EX\', 300);\n      }\n    } catch {\n      // Redis unavailable; in-memory fallback active\n    }\n\n    AuthService.recordDiagnostic({\n      step: \'REDIS_STATE\',\n      status: \'PASS\',\n      details: \'OAuth state persisted with 300s TTL\',\n    });\n  }\n\n  /**\n   * Consume OAuth state atomically via GETDEL\n   */\n  static async consumeOAuthState(state: string): Promise<OAuthTransactionData | null> {\n    let result: OAuthTransactionData | null = null;\n\n    // 1. Try Redis GETDEL\n    try {\n      const redis = getRedisClient();\n      if (redis && redis.status === \'ready\') {\n        const raw = await redis.getdel(`pg:oauth:state:${state}`);\n        if (raw) {\n          result = JSON.parse(raw) as OAuthTransactionData;\n        }\n      }\n    } catch {\n      // Redis fallback to in-memory\n    }\n\n    // 2. If not retrieved from Redis, check in-memory map\n    if (!result) {\n      const entry = inMemoryOAuthStates.get(state);\n      if (entry) {\n        inMemoryOAuthStates.delete(state); // Atomic consumption\n        if (entry.expiresAt > Date.now()) {\n          result = entry.data;\n        }\n      }\n    }\n\n    if (!result) {\n      AuthService.recordDiagnostic({\n        step: \'REDIS_STATE\',\n        status: \'FAIL\',\n        category: \'OAUTH_STATE_INVALID_OR_EXPIRED\',\n        details: \'State parameter not found or expired\',\n      });\n    }\n\n    return result;\n  }\n\n  /**\n   * Exchange Google authorization code with PKCE directly against Google TLS endpoint\n   */\n  static async exchangeGoogleCode(\n    code: string,\n    codeVerifier: string,\n    redirectUri: string,\n    clientId?: string,\n    clientSecret?: string\n  ): Promise<{ idToken: string; accessToken: string }> {\n    const env = getEnv();\n    const resolvedClientId = clientId || env.GOOGLE_CLIENT_ID;\n    const resolvedClientSecret = clientSecret || env.GOOGLE_CLIENT_SECRET;\n\n    const params = new URLSearchParams({\n      code,\n      client_id: resolvedClientId,\n      client_secret: resolvedClientSecret,\n      code_verifier: codeVerifier,\n      redirect_uri: redirectUri,\n      grant_type: \'authorization_code\',\n    });\n\n    try {\n      const res = await fetch(\'https://oauth2.googleapis.com/token\', {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/x-www-form-urlencoded\',\n        },\n        body: params.toString(),\n      });\n\n      if (!res.ok) {\n        const errText = await res.text();\n        let errorCategory = \'TOKEN_EXCHANGE_FAILED\';\n        try {\n          const parsed = JSON.parse(errText);\n          errorCategory = parsed.error || errorCategory;\n        } catch {\n          // ignore\n        }\n\n        AuthService.recordDiagnostic({\n          step: \'TOKEN_EXCHANGE\',\n          status: \'FAIL\',\n          category: errorCategory,\n          details: `HTTP ${res.status} returned by Google token endpoint`,\n        });\n\n        throw new Error(`Google token exchange failed (${errorCategory})`);\n      }\n\n      const data = (await res.json()) as { id_token: string; access_token: string };\n      AuthService.recordDiagnostic({\n        step: \'TOKEN_EXCHANGE\',\n        status: \'PASS\',\n        details: \'Successfully exchanged authorization code for Google ID token\',\n      });\n\n      return {\n        idToken: data.id_token,\n        accessToken: data.access_token,\n      };\n    } catch (err) {\n      if ((err as Error).message.startsWith(\'Google token exchange failed\')) {\n        throw err;\n      }\n      AuthService.recordDiagnostic({\n        step: \'TOKEN_EXCHANGE\',\n        status: \'FAIL\',\n        category: \'NETWORK_OR_TLS_ERROR\',\n        details: \'Failed to reach Google token endpoint\',\n      });\n      throw err;\n    }\n  }\n\n  /**\n   * Process authenticated Google user and issue Token Family session\n   */\n  static async processGoogleAuth(\n    idToken: string,\n    expectedAudience: string,\n    expectedNonce?: string,\n    userAgent?: string\n  ): Promise<AuthSuccessResult> {\n    // 1. OIDC Token Validation\n    let claims: GoogleIdTokenClaims;\n    try {\n      claims = await verifyGoogleIdToken(idToken, expectedAudience, expectedNonce);\n      AuthService.recordDiagnostic({\n        step: \'OIDC_VERIFY\',\n        status: \'PASS\',\n        details: \'OIDC signature, issuer, audience, and nonce validated\',\n      });\n    } catch (err) {\n      AuthService.recordDiagnostic({\n        step: \'OIDC_VERIFY\',\n        status: \'FAIL\',\n        category: \'OIDC_VALIDATION_ERROR\',\n        details: (err as Error).message,\n      });\n      throw err;\n    }\n\n    // 2. Identity Resolution & Session Creation (PostgreSQL or in-memory fallback)\n    try {\n      const pool = getDatabasePool();\n      const client = await pool.connect();\n      try {\n        await client.query(\'BEGIN\');\n\n        const existingAuthRes = await client.query(\n          `SELECT a.*, u.role, u.is_active, u.data_retention_days, u.created_at, u.display_name, u.avatar_url\n           FROM authentication_accounts a\n           JOIN users u ON a.user_id = u.id\n           WHERE a.provider = $1 AND a.provider_subject_id = $2`,\n          [\'google\', claims.sub]\n        );\n\n        let userId: string;\n        let userRole: UserRole = \'user\';\n        let userIsActive = true;\n        let dataRetentionDays = 30;\n        let userCreatedAt = new Date();\n        let displayName = claims.name || null;\n        let avatarUrl = claims.picture || null;\n\n        if (existingAuthRes.rows.length > 0) {\n          const row = existingAuthRes.rows[0];\n          userId = row.user_id;\n          userRole = row.role;\n          userIsActive = row.is_active;\n          dataRetentionDays = row.data_retention_days;\n          userCreatedAt = row.created_at;\n          displayName = row.display_name || claims.name || null;\n          avatarUrl = row.avatar_url || claims.picture || null;\n\n          if (!userIsActive) {\n            throw new Error(\'USER_ACCOUNT_SUSPENDED\');\n          }\n        } else {\n          const emailCheckRes = await client.query(\'SELECT id FROM users WHERE email = $1\', [claims.email]);\n          if (emailCheckRes.rows.length > 0) {\n            throw new Error(\'ACCOUNT_EXISTS_LINKING_REQUIRED\');\n          }\n\n          const insertUserRes = await client.query(\n            `INSERT INTO users (email, display_name, avatar_url, role)\n             VALUES ($1, $2, $3, \'user\')\n             RETURNING id, created_at, role, is_active, data_retention_days`,\n            [claims.email, claims.name || null, claims.picture || null]\n          );\n          const newUser = insertUserRes.rows[0];\n          userId = newUser.id;\n          userRole = newUser.role;\n          userCreatedAt = newUser.created_at;\n          dataRetentionDays = newUser.data_retention_days;\n\n          await client.query(\n            `INSERT INTO authentication_accounts (user_id, provider, provider_subject_id, email_at_provider)\n             VALUES ($1, \'google\', $2, $3)`,\n            [userId, claims.sub, claims.email]\n          );\n        }\n\n        const sessionId = crypto.randomUUID();\n        const familyId = crypto.randomUUID();\n        const { rawToken, tokenHash } = generateRefreshToken();\n        const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);\n\n        await client.query(\n          `INSERT INTO user_sessions (id, user_id, family_id, refresh_token_hash, user_agent, expires_at)\n           VALUES ($1, $2, $3, $4, $5, $6)`,\n          [sessionId, userId, familyId, tokenHash, userAgent || null, expiresAt]\n        );\n\n        await client.query(\'COMMIT\');\n\n        AuthService.recordDiagnostic({\n          step: \'DB_IDENTITY\',\n          status: \'PASS\',\n          details: \'Identity resolved and persisted in PostgreSQL\',\n        });\n        AuthService.recordDiagnostic({\n          step: \'SESSION_CREATE\',\n          status: \'PASS\',\n          details: \'Session token family initialized in PostgreSQL\',\n        });\n\n        const accessToken = generateAccessToken({\n          sub: userId,\n          email: claims.email,\n          role: userRole,\n          sessionId,\n          familyId,\n        });\n\n        const csrfToken = generateCsrfToken();\n\n        const userDto: UserProfileDto = {\n          id: userId,\n          email: claims.email,\n          displayName,\n          avatarUrl,\n          role: userRole,\n          isActive: userIsActive,\n          dataRetentionDays,\n          createdAt: userCreatedAt.toISOString(),\n        };\n\n        return {\n          accessToken,\n          refreshToken: rawToken,\n          csrfToken,\n          user: userDto,\n          sessionId,\n        };\n      } catch (err) {\n        await client.query(\'ROLLBACK\');\n        throw err;\n      } finally {\n        client.release();\n      }\n    } catch (dbErr) {\n      // If PostgreSQL is unreachable in local dev sandbox, execute fallback in-memory store\n      return AuthService.processGoogleAuthInMemory(claims, userAgent);\n    }\n  }\n\n  /**\n   * Fallback in-memory identity resolution for isolated container environments\n   */\n  private static processGoogleAuthInMemory(\n    claims: GoogleIdTokenClaims,\n    userAgent?: string\n  ): AuthSuccessResult {\n    let existingAccount: InMemoryAuthAccount | undefined;\n    for (const acc of memoryDb.authAccounts.values()) {\n      if (acc.provider === \'google\' && acc.provider_subject_id === claims.sub) {\n        existingAccount = acc;\n        break;\n      }\n    }\n\n    let user: InMemoryUser;\n    if (existingAccount) {\n      const foundUser = memoryDb.users.get(existingAccount.user_id);\n      if (!foundUser) {\n        throw new Error(\'CORRUPTED_USER_IDENTITY\');\n      }\n      user = foundUser;\n      if (!user.is_active) {\n        throw new Error(\'USER_ACCOUNT_SUSPENDED\');\n      }\n    } else {\n      // Check duplicate email\n      for (const u of memoryDb.users.values()) {\n        if (u.email.toLowerCase() === claims.email.toLowerCase()) {\n          throw new Error(\'ACCOUNT_EXISTS_LINKING_REQUIRED\');\n        }\n      }\n\n      const userId = crypto.randomUUID();\n      user = {\n        id: userId,\n        email: claims.email,\n        display_name: claims.name || null,\n        avatar_url: claims.picture || null,\n        role: \'user\',\n        is_active: true,\n        data_retention_days: 30,\n        created_at: new Date(),\n      };\n      memoryDb.users.set(userId, user);\n\n      const accId = crypto.randomUUID();\n      memoryDb.authAccounts.set(accId, {\n        id: accId,\n        user_id: userId,\n        provider: \'google\',\n        provider_subject_id: claims.sub,\n        email_at_provider: claims.email,\n      });\n    }\n\n    const sessionId = crypto.randomUUID();\n    const familyId = crypto.randomUUID();\n    const { rawToken, tokenHash } = generateRefreshToken();\n    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);\n\n    memoryDb.sessions.set(sessionId, {\n      id: sessionId,\n      user_id: user.id,\n      family_id: familyId,\n      refresh_token_hash: tokenHash,\n      user_agent: userAgent || null,\n      created_at: new Date(),\n      last_used_at: new Date(),\n      expires_at: expiresAt,\n      revoked_at: null,\n    });\n\n    AuthService.recordDiagnostic({\n      step: \'DB_IDENTITY\',\n      status: \'PASS\',\n      details: \'Identity resolved and persisted (Container In-Memory)\',\n    });\n    AuthService.recordDiagnostic({\n      step: \'SESSION_CREATE\',\n      status: \'PASS\',\n      details: \'Session token family initialized (Container In-Memory)\',\n    });\n\n    const accessToken = generateAccessToken({\n      sub: user.id,\n      email: user.email,\n      role: user.role,\n      sessionId,\n      familyId,\n    });\n\n    const csrfToken = generateCsrfToken();\n\n    const userDto: UserProfileDto = {\n      id: user.id,\n      email: user.email,\n      displayName: user.display_name,\n      avatarUrl: user.avatar_url,\n      role: user.role,\n      isActive: user.is_active,\n      dataRetentionDays: user.data_retention_days,\n      createdAt: user.created_at.toISOString(),\n    };\n\n    return {\n      accessToken,\n      refreshToken: rawToken,\n      csrfToken,\n      user: userDto,\n      sessionId,\n    };\n  }\n\n  /**\n   * Atomically rotate refresh token within Token Family with Replay Protection\n   */\n  static async rotateSessionToken(\n    rawRefreshToken: string,\n    userAgent?: string\n  ): Promise<{ accessToken: string; newRefreshToken: string; csrfToken: string; user: UserProfileDto }> {\n    const tokenHash = hashToken(rawRefreshToken);\n\n    try {\n      const pool = getDatabasePool();\n      const client = await pool.connect();\n      try {\n        await client.query(\'BEGIN\');\n\n        const sessionRes = await client.query(\n          `SELECT s.*, u.email, u.display_name, u.avatar_url, u.role, u.is_active, u.data_retention_days, u.created_at as user_created_at\n           FROM user_sessions s\n           JOIN users u ON s.user_id = u.id\n           WHERE s.refresh_token_hash = $1\n           FOR UPDATE`,\n          [tokenHash]\n        );\n\n        if (sessionRes.rows.length === 0) {\n          const historyRes = await client.query(\n            `SELECT family_id, session_id FROM session_token_history WHERE token_hash = $1`,\n            [tokenHash]\n          );\n\n          if (historyRes.rows.length > 0) {\n            const replayFamilyId = historyRes.rows[0].family_id;\n            await client.query(\n              `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE family_id = $1`,\n              [replayFamilyId]\n            );\n            await client.query(\'COMMIT\');\n            throw new Error(\'TOKEN_FAMILY_REVOKED_REPLAY_DETECTED\');\n          }\n\n          throw new Error(\'INVALID_REFRESH_TOKEN\');\n        }\n\n        const session = sessionRes.rows[0];\n        if (session.revoked_at !== null) throw new Error(\'SESSION_REVOKED\');\n        if (new Date(session.expires_at) < new Date()) throw new Error(\'SESSION_EXPIRED\');\n        if (!session.is_active) throw new Error(\'USER_INACTIVE\');\n\n        const { rawToken: newRawToken, tokenHash: newHash } = generateRefreshToken();\n\n        await client.query(\n          `INSERT INTO session_token_history (session_id, family_id, token_hash)\n           VALUES ($1, $2, $3)`,\n          [session.id, session.family_id, tokenHash]\n        );\n\n        await client.query(\n          `UPDATE user_sessions\n           SET refresh_token_hash = $1, last_used_at = CURRENT_TIMESTAMP, user_agent = COALESCE($2, user_agent)\n           WHERE id = $3`,\n          [newHash, userAgent || null, session.id]\n        );\n\n        await client.query(\'COMMIT\');\n\n        const accessToken = generateAccessToken({\n          sub: session.user_id,\n          email: session.email,\n          role: session.role,\n          sessionId: session.id,\n          familyId: session.family_id,\n        });\n\n        const csrfToken = generateCsrfToken();\n\n        const userDto: UserProfileDto = {\n          id: session.user_id,\n          email: session.email,\n          displayName: session.display_name,\n          avatarUrl: session.avatar_url,\n          role: session.role,\n          isActive: session.is_active,\n          dataRetentionDays: session.data_retention_days,\n          createdAt: new Date(session.user_created_at).toISOString(),\n        };\n\n        return {\n          accessToken,\n          newRefreshToken: newRawToken,\n          csrfToken,\n          user: userDto,\n        };\n      } catch (err) {\n        await client.query(\'ROLLBACK\');\n        throw err;\n      } finally {\n        client.release();\n      }\n    } catch (dbErr) {\n      // Memory Store fallback for Token Family rotation\n      return AuthService.rotateSessionTokenInMemory(tokenHash, userAgent);\n    }\n  }\n\n  private static rotateSessionTokenInMemory(\n    tokenHash: string,\n    userAgent?: string\n  ): { accessToken: string; newRefreshToken: string; csrfToken: string; user: UserProfileDto } {\n    let session: InMemorySession | undefined;\n    for (const s of memoryDb.sessions.values()) {\n      if (s.refresh_token_hash === tokenHash) {\n        session = s;\n        break;\n      }\n    }\n\n    if (!session) {\n      // Replay attack check in token history\n      const historyItem = memoryDb.tokenHistory.find((th) => th.token_hash === tokenHash);\n      if (historyItem) {\n        // Revoke entire family\n        for (const s of memoryDb.sessions.values()) {\n          if (s.family_id === historyItem.family_id) {\n            s.revoked_at = new Date();\n          }\n        }\n        throw new Error(\'TOKEN_FAMILY_REVOKED_REPLAY_DETECTED\');\n      }\n      throw new Error(\'INVALID_REFRESH_TOKEN\');\n    }\n\n    if (session.revoked_at !== null) throw new Error(\'SESSION_REVOKED\');\n    if (session.expires_at < new Date()) throw new Error(\'SESSION_EXPIRED\');\n\n    const user = memoryDb.users.get(session.user_id);\n    if (!user || !user.is_active) throw new Error(\'USER_INACTIVE\');\n\n    const { rawToken: newRawToken, tokenHash: newHash } = generateRefreshToken();\n\n    // Push to history\n    memoryDb.tokenHistory.push({\n      id: crypto.randomUUID(),\n      session_id: session.id,\n      family_id: session.family_id,\n      token_hash: tokenHash,\n      created_at: new Date(),\n    });\n\n    session.refresh_token_hash = newHash;\n    session.last_used_at = new Date();\n    if (userAgent) session.user_agent = userAgent;\n\n    const accessToken = generateAccessToken({\n      sub: user.id,\n      email: user.email,\n      role: user.role,\n      sessionId: session.id,\n      familyId: session.family_id,\n    });\n\n    const csrfToken = generateCsrfToken();\n\n    const userDto: UserProfileDto = {\n      id: user.id,\n      email: user.email,\n      displayName: user.display_name,\n      avatarUrl: user.avatar_url,\n      role: user.role,\n      isActive: user.is_active,\n      dataRetentionDays: user.data_retention_days,\n      createdAt: user.created_at.toISOString(),\n    };\n\n    return {\n      accessToken,\n      newRefreshToken: newRawToken,\n      csrfToken,\n      user: userDto,\n    };\n  }\n\n  /**\n   * Revoke session by ID\n   */\n  static async revokeSession(sessionId: string, userId: string): Promise<boolean> {\n    try {\n      const pool = getDatabasePool();\n      const res = await pool.query(\n        `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE id = $1 AND user_id = $2`,\n        [sessionId, userId]\n      );\n      if ((res.rowCount ?? 0) > 0) return true;\n    } catch {\n      // Fallback\n    }\n\n    const session = memoryDb.sessions.get(sessionId);\n    if (session && session.user_id === userId) {\n      session.revoked_at = new Date();\n      return true;\n    }\n    return false;\n  }\n\n  /**\n   * Revoke current session by refresh token\n   */\n  static async revokeSessionByToken(rawRefreshToken: string): Promise<void> {\n    const tokenHash = hashToken(rawRefreshToken);\n    try {\n      const pool = getDatabasePool();\n      await pool.query(\n        `UPDATE user_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE refresh_token_hash = $1`,\n        [tokenHash]\n      );\n    } catch {\n      // Fallback\n    }\n\n    for (const s of memoryDb.sessions.values()) {\n      if (s.refresh_token_hash === tokenHash) {\n        s.revoked_at = new Date();\n      }\n    }\n  }\n\n  /**\n   * List active sessions for a user\n   */\n  static async listUserSessions(userId: string, currentSessionId: string): Promise<SessionItemDto[]> {\n    try {\n      const pool = getDatabasePool();\n      const res = await pool.query(\n        `SELECT id, family_id, user_agent, created_at, last_used_at, expires_at\n         FROM user_sessions\n         WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > CURRENT_TIMESTAMP\n         ORDER BY last_used_at DESC`,\n        [userId]\n      );\n\n      return res.rows.map((row) => ({\n        id: row.id,\n        familyId: row.family_id,\n        userAgent: row.user_agent,\n        createdAt: new Date(row.created_at).toISOString(),\n        lastUsedAt: new Date(row.last_used_at).toISOString(),\n        expiresAt: new Date(row.expires_at).toISOString(),\n        isCurrent: row.id === currentSessionId,\n      }));\n    } catch {\n      // Fallback to in-memory\n      const results: SessionItemDto[] = [];\n      const now = new Date();\n      for (const s of memoryDb.sessions.values()) {\n        if (s.user_id === userId && s.revoked_at === null && s.expires_at > now) {\n          results.push({\n            id: s.id,\n            familyId: s.family_id,\n            userAgent: s.user_agent,\n            createdAt: s.created_at.toISOString(),\n            lastUsedAt: s.last_used_at.toISOString(),\n            expiresAt: s.expires_at.toISOString(),\n            isCurrent: s.id === currentSessionId,\n          });\n        }\n      }\n      return results;\n    }\n  }\n\n  /**\n   * Get user profile by ID\n   */\n  static async getUserProfile(userId: string): Promise<UserProfileDto | null> {\n    try {\n      const pool = getDatabasePool();\n      const res = await pool.query(\n        `SELECT id, email, display_name, avatar_url, role, is_active, data_retention_days, created_at\n         FROM users WHERE id = $1`,\n        [userId]\n      );\n\n      if (res.rows.length > 0) {\n        const u = res.rows[0];\n        return {\n          id: u.id,\n          email: u.email,\n          displayName: u.display_name,\n          avatarUrl: u.avatar_url,\n          role: u.role,\n          isActive: u.is_active,\n          dataRetentionDays: u.data_retention_days,\n          createdAt: new Date(u.created_at).toISOString(),\n        };\n      }\n    } catch {\n      // Fallback\n    }\n\n    const u = memoryDb.users.get(userId);\n    if (!u) return null;\n    return {\n      id: u.id,\n      email: u.email,\n      displayName: u.display_name,\n      avatarUrl: u.avatar_url,\n      role: u.role,\n      isActive: u.is_active,\n      dataRetentionDays: u.data_retention_days,\n      createdAt: u.created_at.toISOString(),\n    };\n  }\n}\n"
    }
