      replacement_content: "import Redis from \'ioredis\';\nimport { getEnv } from \'./env\';\n\nlet redisClient: Redis | null = null;\n\nexport function getRedisClient(): Redis {\n  if (!redisClient) {\n    const env = getEnv();\n    if (env.REDIS_URL) {\n      redisClient = new Redis(env.REDIS_URL, {\n        lazyConnect: true,\n        maxRetriesPerRequest: 1,\n        connectTimeout: 2000,\n        retryStrategy: (times) => {\n          if (times > 3) return null;\n          return Math.min(times * 100, 1000);\n        },\n      });\n    } else {\n      redisClient = new Redis({\n        host: env.REDIS_HOST,\n        port: env.REDIS_PORT,\n        password: env.REDIS_PASSWORD || undefined,\n        lazyConnect: true,\n        maxRetriesPerRequest: 1,\n        connectTimeout: 2000,\n        retryStrategy: (times) => {\n          if (times > 3) return null;\n          return Math.min(times * 100, 1000);\n        },\n      });\n    }\n\n    redisClient.on(\'error\', (err) => {\n      // Suppress noisy uncaught errors in development when redis container is offline\n      if (env.NODE_ENV === \'development\') {\n        // quiet debug log\n      } else {\n        console.error(\'Redis Client Error:\', err);\n      }\n    });\n  }\n  return redisClient;\n}\n\nexport async function checkRedisHealth(): Promise<{\n  status: \'healthy\' | \'degraded\' | \'unhealthy\';\n  latencyMs?: number;\n  message?: string;\n  details?: Record<string, unknown>;\n}> {\n  const start = Date.now();\n  try {\n    const client = getRedisClient();\n    if (client.status !== \'ready\') {\n      await client.connect();\n    }\n    const pong = await client.ping();\n    const latency = Date.now() - start;\n    return {\n      status: pong === \'PONG\' ? \'healthy\' : \'degraded\',\n      latencyMs: latency,\n      message: \'Redis event bus active\',\n      details: {\n        status: client.status,\n      },\n    };\n  } catch (error) {\n    return {\n      status: \'degraded\',\n      latencyMs: Date.now() - start,\n      message: `Redis unavailable or isolated: ${(error as Error).message}`,\n      details: {\n        targetHost: getEnv().REDIS_HOST,\n        targetPort: getEnv().REDIS_PORT,\n      },\n    };\n  }\n}\n\nexport async function closeRedisClient(): Promise<void> {\n  if (redisClient) {\n    try {\n      await redisClient.quit();\n    } catch {\n      redisClient.disconnect();\n    }\n    redisClient = null;\n  }\n}\n"
    }
