# ============================================================================
# PRIVACY GATEWAY — ENVIRONMENT CONFIGURATION (PHASE 2)
# ============================================================================

# Service Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database & Redis Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=privacy_gateway
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=pgsecret_change_in_production

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redissecret_change_in_production

# Google OAuth 2.0 / OpenID Connect (Development Credentials)
# Web Client:
GOOGLE_CLIENT_ID=your_dev_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_dev_web_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Native Desktop Client (For Phase 5 Preparation):
GOOGLE_DESKTOP_CLIENT_ID=your_dev_desktop_client_id.apps.googleusercontent.com

# Asymmetric RS256 JWT Configuration
# In production, supply 2048-bit or 4096-bit RSA PEM strings.
# In development, leave blank to use auto-generated ephemeral keypair.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=pg-auth-2026-v1
JWT_ISSUER=https://api.privacygateway.net
JWT_AUDIENCE=https://privacygateway.net

# CORS & Security Limits
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
